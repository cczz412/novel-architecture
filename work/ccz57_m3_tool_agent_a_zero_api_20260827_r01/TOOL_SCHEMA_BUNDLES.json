    "canonical_internal_schema": [
      {
        "description": "读取当前唯一 C2 责任段。",
        "name": "read_current_c2_segment",
        "parameters": {
          "additionalProperties": false,
          "properties": {
            "expected_revision_ref": {
              "additionalProperties": false,
              "properties": {
                "chapter_id": {
                  "pattern": "^c[0-9]{2,}$",
                  "type": "string"
                },
                "revision_no": {
                  "minimum": 1,
                  "type": "integer"
                },
                "revision_text_sha256": {
                  "pattern": "^[0-9a-f]{64}$",
                  "type": "string"
                }
              },
              "required": [
                "chapter_id",
                "revision_no",
                "revision_text_sha256"
              ],
              "type": "object"
            }
          },
          "required": [
            "expected_revision_ref"
          ],
          "type": "object"
        }
      },
      {
