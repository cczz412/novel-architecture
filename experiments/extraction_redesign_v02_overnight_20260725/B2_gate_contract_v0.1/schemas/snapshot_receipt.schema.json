{
  "$id": "https://local.invalid/contracts/v02/snapshot_receipt.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "actual_snapshot_count": {
      "minimum": 1,
      "type": "integer"
    },
    "actual_snapshot_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "candidate_id": {
      "minLength": 1,
      "type": "string"
    },
    "candidate_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "contract_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "expected_snapshot_count": {
      "minimum": 1,
      "type": "integer"
    },
    "expected_snapshot_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "failure_codes": {
      "items": {
