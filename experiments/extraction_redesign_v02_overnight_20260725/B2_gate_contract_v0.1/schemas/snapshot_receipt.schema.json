          "properties": {
            "accepted": {
              "const": true
            },
            "hard_stopped": {
              "const": false
            },
            "rejected": {
              "const": false
            }
          }
        },
        {
          "properties": {
            "accepted": {
              "const": false
            },
            "hard_stopped": {
              "const": false
            },
            "rejected": {
              "const": true
            }
          }
        },
        {
          "properties": {
            "accepted": {
              "const": false
            },
            "hard_stopped": {
              "const": true
            },
            "rejected": {
              "const": false
            }
          }
        }
      ],
      "properties": {
        "accepted": {
          "type": "boolean"
        },
        "hard_stopped": {
          "type": "boolean"
        },
        "rejected": {
          "type": "boolean"
        }
      },
      "required": [
        "accepted",
        "rejected",
        "hard_stopped"
      ],
      "type": "object"
