  "required": [
    "schema_version",
    "receipt_id",
    "module_id",
    "candidate_id",
    "candidate_sha256",
    "contract_hash",
    "independent_recompute",
    "expected_snapshot_count",
    "actual_snapshot_count",
    "expected_snapshot_sha256",
    "actual_snapshot_sha256",
    "remaining_h_code_count",
    "metrics",
    "terminal_flags",
