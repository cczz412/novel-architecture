{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "repo-bridge-snapshot-v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "view_kind",
    "authoritative",
    "repo_id",
    "snapshot_id",
    "snapshot_digest_sha256",
    "observation_id",
    "observation_digest_sha256",
    "workspace_fingerprint_sha256",
    "inventory_fingerprint_sha256",
    "source_bindings_sha256",
    "git",
    "generator",
    "coverage"
  ],
  "properties": {
    "schema_version": {"const": "repo-bridge-snapshot-v1"},
    "view_kind": {"const": "derived_snapshot_view"},
    "authoritative": {"const": false},
    "repo_id": {"type": "string", "minLength": 1},
    "snapshot_id": {"type": "string", "pattern": "^rb1-[0-9a-f]{20}$"},
    "snapshot_digest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "observation_id": {"type": "string", "pattern": "^obs1-[0-9a-f]{20}$"},
    "observation_digest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "workspace_fingerprint_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "inventory_fingerprint_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_bindings_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "git": {"type": "object"},
    "generator": {"type": "object"},
    "coverage": {"type": "object"}
  }
}
