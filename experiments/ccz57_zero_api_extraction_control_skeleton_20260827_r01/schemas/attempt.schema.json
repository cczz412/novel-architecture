{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cczz412/novel-architecture/experiments/ccz57-zero-api/attempt-v1",
  "title": "CCZ-57 0 API 不可变尝试",
  "type": "object",
  "required": [
    "schema_version",
    "attempt_id",
    "run_id",
    "input_snapshot_id",
    "source_refs",
    "retry_index",
    "request",
    "transport",
    "usage",
    "raw_response",
    "outcome"
  ],
  "properties": {
    "schema_version": {"const": "ccz57-zero-api-attempt-v1"},
    "attempt_id": {"type": "string", "pattern": "^att_[0-9a-f]{24}$"},
    "run_id": {"type": "string", "minLength": 1},
    "input_snapshot_id": {"type": "string", "pattern": "^input_[0-9a-f]{24}$"},
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/file_ref"}
    },
    "retry_index": {"type": "integer", "minimum": 0},
    "request": {
      "type": "object",
      "required": [
        "provider",
        "requested_model",
        "expected_response_model",
        "thinking",
        "reasoning_effort",
        "temperature",
        "max_output_tokens",
        "prompt_sha256",
        "schema_sha256",
        "input_sha256",
        "request_body"
      ],
      "properties": {
        "provider": {"type": "string", "minLength": 1},
        "requested_model": {"type": "string", "minLength": 1},
        "expected_response_model": {"type": "string", "minLength": 1},
        "thinking": {"enum": ["disabled", "enabled", "provider_forced"]},
        "reasoning_effort": {
          "type": ["string", "null"],
          "enum": [null, "none", "low", "medium", "high", "xhigh", "max", "provider_default"]
        },
        "temperature": {"type": "number"},
        "max_output_tokens": {"type": "integer", "minimum": 1},
        "prompt_sha256": {"$ref": "#/$defs/sha256"},
        "schema_sha256": {"$ref": "#/$defs/sha256"},
        "input_sha256": {"$ref": "#/$defs/sha256"},
        "request_body": {"$ref": "#/$defs/file_ref"}
      },
      "additionalProperties": false
    },
    "transport": {
      "type": "object",
      "required": [
        "imported_without_network",
        "http_status",
        "timed_out",
        "finish_reason",
        "incomplete_reason",
        "response_model",
        "identity_match"
      ],
      "properties": {
        "imported_without_network": {"const": true},
        "http_status": {"type": ["integer", "null"], "minimum": 100, "maximum": 599},
        "timed_out": {"type": "boolean"},
        "finish_reason": {"type": ["string", "null"]},
        "incomplete_reason": {"type": ["string", "null"]},
        "response_model": {"type": ["string", "null"]},
        "identity_match": {"type": ["boolean", "null"]}
      },
      "additionalProperties": false
    },
    "usage": {
      "type": "object",
      "required": ["prompt_tokens", "completion_tokens", "reasoning_tokens", "total_tokens", "elapsed_ms"],
      "properties": {
        "prompt_tokens": {"type": ["integer", "null"], "minimum": 0},
        "completion_tokens": {"type": ["integer", "null"], "minimum": 0},
        "reasoning_tokens": {"type": ["integer", "null"], "minimum": 0},
        "total_tokens": {"type": ["integer", "null"], "minimum": 0},
        "elapsed_ms": {"type": ["integer", "null"], "minimum": 0}
      },
      "additionalProperties": false
    },
    "raw_response": {
      "type": "object",
      "required": ["stdout", "stderr"],
      "properties": {
        "stdout": {"$ref": "#/$defs/file_ref"},
        "stderr": {
          "oneOf": [
            {"$ref": "#/$defs/file_ref"},
            {"type": "null"}
          ]
        }
      },
      "additionalProperties": false
    },
    "outcome": {
      "type": "object",
      "required": ["truncated", "envelope_json_state", "content_json_state", "schema_state", "candidate_version_id"],
      "properties": {
        "truncated": {"type": "boolean"},
        "envelope_json_state": {"enum": ["NOT_CHECKED", "PARSE_OK", "PARSE_ERROR", "EMPTY"]},
        "content_json_state": {"enum": ["NOT_CHECKED", "PARSE_OK", "PARSE_ERROR", "DUPLICATE_KEY", "EMPTY"]},
        "schema_state": {"enum": ["NOT_CHECKED", "PASS", "FAIL"]},
        "candidate_version_id": {
          "oneOf": [
            {"type": "string", "pattern": "^ver_[0-9a-f]{24}$"},
            {"type": "null"}
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "file_ref": {
      "type": "object",
      "required": ["path", "sha256", "bytes"],
      "properties": {
        "path": {"type": "string", "pattern": "^(?!/)(?!.*\\.\\./).+$"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "bytes": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
