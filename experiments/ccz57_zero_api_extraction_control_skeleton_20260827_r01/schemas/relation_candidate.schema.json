{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cczz412/novel-architecture/experiments/ccz57-zero-api/relation-candidate-v1",
  "title": "CCZ-57 0 API 旁路关系候选",
  "type": "object",
  "required": [
    "schema_version",
    "relation_candidate_id",
    "run_id",
    "base_version_id",
    "relation_type",
    "from_fact_id",
    "to_fact_id",
    "evidence_refs",
    "trigger_diagnostic_ids",
    "status",
    "may_write_v21_facts",
    "semantic_claim_allowed"
  ],
  "properties": {
    "schema_version": {"const": "ccz57-zero-api-relation-candidate-v1"},
    "relation_candidate_id": {"type": "string", "pattern": "^relcand_[0-9a-f]{24}$"},
    "run_id": {"type": "string", "minLength": 1},
    "base_version_id": {"type": "string", "pattern": "^ver_[0-9a-f]{24}$"},
    "relation_type": {"enum": ["CAUSES", "TEMPORAL_BEFORE", "COREFERENCE", "STATE_TRANSITION", "SOCIAL_RELATION_CHANGE"]},
    "from_fact_id": {"type": "string", "pattern": "^fact_[0-9a-f]{24}$"},
    "to_fact_id": {"type": "string", "pattern": "^fact_[0-9a-f]{24}$"},
    "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "trigger_diagnostic_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^diag_[0-9a-f]{24}$"}, "uniqueItems": true},
    "status": {"enum": ["PROPOSED_FOR_HUMAN", "REJECTED", "VERIFIED_CANDIDATE"]},
    "may_write_v21_facts": {"const": false},
    "semantic_claim_allowed": {"const": false}
  },
  "additionalProperties": false
}
