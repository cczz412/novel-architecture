{
  "schema_version": "model-benchmark-provider-adapters-v2",
  "providers": {
    "qianwen_platform": {
      "provider_config": "config/providers/qianwen_platform_multi_model.json",
      "transport": "openai_chat_completions",
      "key_loader": "tools/provider_keychain.sh run qianwen_platform",
      "profiles": {
        "thinking_32k_prompt_json": {
          "purpose": "显式开启 Qwen3.7-Plus 思考，最终正文由本地 JSON 与 Schema 闸验收",
          "validated_model_ids": [
            "qwen3.7-plus"
          ],
          "drop_fields": [
            "reasoning_effort",
            "max_tokens",
            "response_format"
          ],
          "set_fields": {
            "enable_thinking": true,
            "thinking_budget": 32768
          },
          "require_nonempty_reasoning_content": true,
          "keep_fields": [
            "messages",
            "temperature",
            "n"
          ],
          "compatibility_notes": [
            "千问 Chat Completions 不支持 reasoning_effort，该字段会被静默忽略，因此发网前明确移除并留账。",
            "Qwen3.7-Plus 思考模式与 response_format=json_object 不兼容；本档移除 response_format，最终 content 仍须通过本地 JSON、Schema 与证据锚机械闸。",
            "thinking_budget=32768 是本项目的试验护栏，不冒充供应商的 medium 或 high 档。",
            "不设置 max_tokens，避免供应商兼容差异与正文截断；finish_reason=length 仍按硬停处理。"
          ]
        }
      }
    },
    "volcengine_ark": {
      "provider_config": "config/providers/volcengine_ark_multi_model.json",
      "transport": "openai_chat_completions",
      "key_loader": "tools/provider_keychain.sh run volcengine_ark",
      "profiles": {}
    },
    "tencent_tokenhub": {
      "provider_config": "config/providers/tencent_tokenhub_multi_model.json",
      "transport": "openai_chat_completions",
      "key_loader": "tools/provider_keychain.sh run tencent_tokenhub",
      "profiles": {
        "thinking_high_structured_json": {
          "purpose": "腾讯 TokenHub 明确支持高档推理、最终由本地 JSON 闸验收的模型横向档",
          "validated_model_ids": [
            "hy3",
            "deepseek-v4-flash",
            "deepseek-v4-pro"
          ],
          "drop_fields": [
            "response_format"
          ],
          "set_fields": {
            "thinking": {
              "type": "enabled"
            },
            "reasoning_effort": "high"
          },
          "require_nonempty_reasoning_content": true,
          "keep_fields": [
            "messages",
            "temperature",
            "n",
            "max_tokens"
          ],
          "compatibility_notes": [
            "thinking.type=enabled 与 reasoning_effort=high 均来自腾讯 TokenHub 深度思考合同。",
            "只准用于本白名单三款；其他模型不得套用 reasoning_effort。",
            "思考档不同时发送 response_format；最终正文由本地 JSON、Schema 与证据锚机械闸验收。",
            "精确型号白名单是允许进入首轮兼容试验，不代表已经完成真实参数兼容验证。"
          ]
        },
        "thinking_structured_json": {
          "purpose": "腾讯 TokenHub 支持思考、但未明确支持 reasoning_effort 的本地 JSON 验收档",
          "validated_model_ids": [
            "deepseek-v4-flash-202605",
            "deepseek-v4-pro-202606",
            "glm-5.2",
            "glm-5.1",
            "kimi-k2.7-code-highspeed",
            "kimi-k3",
            "kimi-k2.7-code",
            "kimi-k2.6"
          ],
          "drop_fields": [
            "reasoning_effort",
            "response_format"
          ],
          "set_fields": {
            "thinking": {
              "type": "enabled"
            }
          },
          "require_nonempty_reasoning_content": true,
          "keep_fields": [
            "messages",
            "temperature",
            "n",
            "max_tokens"
          ],
          "compatibility_notes": [
            "显式开启思考，但不把 reasoning_effort 强套给官方未列入档位支持表的模型。",
            "思考档不同时发送 response_format；最终正文由本地 JSON、Schema 与证据锚机械闸验收。",
            "模型能力来自腾讯最新能力表；首次运行仍须通过 /v1/models 在线状态闸和真实兼容样张。"
          ]
        }
      }
    },
    "longcat_platform": {
      "provider_config": "config/providers/longcat_platform.json",
      "transport": "openai_chat_completions",
      "key_loader": "source /Users/a1234/挣钱/danmaku-psychology-workspace/06_operations/api-pool/scripts/longcat-env.zsh",
      "profiles": {
        "thinking_prompt_json": {
          "purpose": "显式开启 LongCat-2.0 思考，最终正文由本地 JSON、Schema 与证据锚机械闸验收",
          "validated_model_ids": [
            "LongCat-2.0"
          ],
          "drop_fields": [
            "reasoning_effort",
            "response_format",
            "n"
          ],
          "set_fields": {
            "thinking": {
              "type": "enabled"
            }
          },
          "require_nonempty_reasoning_content": true,
          "single_sample_via_response_gate": true,
          "keep_fields": [
            "messages",
            "temperature",
            "max_tokens"
          ],
          "compatibility_notes": [
            "LongCat 官方合同只给 thinking.type=enabled/disabled，不发送 reasoning_effort 或自造思考档位。",
            "官方参数表未列 response_format 与 n；请求依靠冻结 Prompt 要求 JSON，最终正文由本地机械闸验收。",
            "max_tokens=32000 与本阶段基线相同，低于 LongCat-2.0 官方 131072 上限。",
            "钥匙继续由同级公共 API 池加载，不复制进本仓。"
          ]
        }
      }
    }
  }
}
