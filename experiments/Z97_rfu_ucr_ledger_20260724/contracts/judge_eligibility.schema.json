    "candidate_family": {
      "type": "string",
      "minLength": 1
    },
    "candidate_checkpoint": {
      "type": "string",
      "minLength": 1
    },
    "candidate_training_lineage": {
      "type": "string",
      "minLength": 1
    },
    "judge_kind": {
      "type": "string",
      "minLength": 1
    },
    "judge_provider": {
      "type": "string",
      "minLength": 1
    },
    "judge_family": {
      "type": "string",
      "minLength": 1
    },
    "judge_checkpoint": {
      "type": "string",
      "minLength": 1
    },
    "judge_training_lineage": {
      "type": "string",
      "minLength": 1
    },
    "same_family": {
      "type": "boolean"
    },
    "same_checkpoint": {
      "type": "boolean"
    },
    "judge_trained_on_scored_outputs": {
      "type": "boolean"
    },
    "candidate_identity_visible": {
      "type": "boolean"
    },
    "historical_scores_visible": {
      "type": "boolean"
    },
    "repair_logs_visible": {
      "type": "boolean"
    },
    "eligible": {
