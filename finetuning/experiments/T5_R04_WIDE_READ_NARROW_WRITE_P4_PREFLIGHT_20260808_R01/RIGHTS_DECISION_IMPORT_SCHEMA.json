{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/t5-r04-p4/rights-decision-import-row-v1",
  "title": "T5 R04 P4 rights decision import row",
  "description": "One JSONL decision row. Approval-only evidence fields are forbidden for unresolved, unknown, and rejection rows.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "group_id",
    "source_id",
    "book_id",
    "book_title",
    "row_count",
    "fact_count",
    "cz_decision",
    "decision_scope",
    "authority_document_path",
    "authority_document_sha256",
    "rights_holder",
    "allowed_use",
    "validity",
    "cz_note"
  ],
  "properties": {
    "group_id": {
      "type": "string",
      "pattern": "^R[0-9]{3}$"
    },
    "source_id": {
      "type": "string",
      "minLength": 1
    },
    "book_id": {
      "type": "string",
      "minLength": 1
    },
    "book_title": {
      "type": "string",
      "minLength": 1
    },
    "row_count": {
      "type": "integer",
      "minimum": 1
    },
    "fact_count": {
      "type": "integer",
      "minimum": 1
    },
    "cz_decision": {
      "enum": [
        "CZ_DECISION_REQUIRED",
        "APPROVE_FOR_INTERNAL_TRAINING",
        "REJECT_FOR_TRAINING",
        "KEEP_RIGHTS_UNKNOWN"
      ]
    },
    "decision_scope": {
      "type": [
        "string",
        "null"
      ]
    },
    "authority_document_path": {
      "type": [
        "string",
        "null"
      ]
    },
    "authority_document_sha256": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/sha256"
        }
      ]
    },
    "rights_holder": {
      "type": [
        "string",
        "null"
      ]
    },
    "allowed_use": {
      "enum": [
        null,
        "INTERNAL_MODEL_TRAINING",
        "FORBIDDEN"
      ]
    },
    "validity": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/validity"
        }
      ]
    },
    "cz_note": {
      "type": [
        "string",
        "null"
      ]
    },
    "author_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "author_name": {
      "type": [
        "string",
        "null"
      ]
    },
    "source_sha256": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/sha256"
        }
      ]
    },
    "row_scope": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/row_scope"
        }
      ]
    },
    "authority_snapshot_path": {
      "type": [
        "string",
        "null"
      ]
    },
    "authority_snapshot_sha256": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/sha256"
        }
      ]
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "validity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "valid_from",
        "valid_until"
      ],
      "properties": {
        "valid_from": {
          "type": "string",
          "format": "date"
        },
        "valid_until": {
          "type": "string",
          "format": "date"
        }
      }
    },
    "row_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "row_ids",
        "row_count",
        "fact_count"
      ],
      "properties": {
        "row_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "row_count": {
          "type": "integer",
          "minimum": 1
        },
        "fact_count": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "derived_candidate_bindings": {
      "type": "object",
      "required": [
        "source_groups_authority_snapshot_sha256",
        "source_group_sha256",
        "decision_row_sha256",
        "allowed_use",
        "validity",
        "import_mode",
        "validation_date",
        "replay_only",
        "test_only",
        "candidate_rights_status",
        "candidate_status",
        "training_eligible",
        "production_promoted"
      ],
      "properties": {
        "source_groups_authority_snapshot_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "source_group_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "decision_row_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "allowed_use": {
          "enum": [
            null,
            "INTERNAL_MODEL_TRAINING",
            "FORBIDDEN"
          ]
        },
        "validity": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "valid_from",
                "valid_until"
              ],
              "properties": {
                "valid_from": {
                  "type": "string",
                  "format": "date"
                },
                "valid_until": {
                  "type": "string",
                  "format": "date"
                }
              }
            }
          ]
        },
        "import_mode": {
          "enum": [
            "DRY_RUN",
            "REALTIME_CANDIDATE",
            "REPLAY_ONLY"
          ]
        },
        "validation_date": {
          "type": "string",
          "format": "date"
        },
        "replay_only": {
          "type": "boolean"
        },
        "test_only": {
          "type": "boolean"
        },
        "candidate_rights_status": {
          "type": "string",
          "minLength": 1
        },
        "candidate_status": {
          "enum": [
            "CANDIDATE_PENDING_CZ_CONFIRMATION",
            "TEST_ONLY_NOT_A_CANDIDATE"
          ]
        },
        "training_eligible": {
          "const": false
        },
        "production_promoted": {
          "const": false
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "import_mode": {
                "const": "REPLAY_ONLY"
              }
            },
            "required": [
              "import_mode"
            ]
          },
          "then": {
            "properties": {
              "replay_only": {
                "const": true
              },
              "candidate_rights_status": {
                "const": "RIGHTS_REPLAY_OBSERVATION_ONLY"
              },
              "allowed_use": {
                "type": "null"
              },
              "training_eligible": {
                "const": false
              },
              "production_promoted": {
                "const": false
              }
            }
          },
          "else": {
            "properties": {
              "replay_only": {
                "const": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "test_only": {
                "const": true
              }
            },
            "required": [
              "test_only"
            ]
          },
          "then": {
            "properties": {
              "candidate_status": {
                "const": "TEST_ONLY_NOT_A_CANDIDATE"
              },
              "allowed_use": {
                "type": "null"
              },
              "training_eligible": {
                "const": false
              },
              "production_promoted": {
                "const": false
              }
            }
          },
          "else": {
            "properties": {
              "candidate_status": {
                "const": "CANDIDATE_PENDING_CZ_CONFIRMATION"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "test_only": {
                "const": true
              },
              "import_mode": {
                "enum": [
                  "DRY_RUN",
                  "REALTIME_CANDIDATE"
                ]
              }
            },
            "required": [
              "test_only",
              "import_mode"
            ]
          },
          "then": {
            "properties": {
              "candidate_rights_status": {
                "const": "RIGHTS_TEST_ONLY_OBSERVATION"
              }
            }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "cz_decision": {
            "const": "APPROVE_FOR_INTERNAL_TRAINING"
          }
        },
        "required": [
          "cz_decision"
        ]
      },
      "then": {
        "required": [
          "author_id",
          "author_name",
          "source_sha256",
          "row_scope",
          "authority_snapshot_path",
          "authority_snapshot_sha256"
        ],
        "properties": {
          "decision_scope": {
            "const": "INTERNAL_MODEL_TRAINING"
          },
          "allowed_use": {
            "const": "INTERNAL_MODEL_TRAINING"
          },
          "authority_document_path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^/"
          },
          "authority_document_sha256": {
            "$ref": "#/$defs/sha256"
          },
          "rights_holder": {
            "type": "string",
            "minLength": 1
          },
          "validity": {
            "$ref": "#/$defs/validity"
          },
          "author_id": {
            "type": "string",
            "minLength": 1
          },
          "author_name": {
            "type": "string",
            "minLength": 1
          },
          "source_sha256": {
            "$ref": "#/$defs/sha256"
          },
          "row_scope": {
            "$ref": "#/$defs/row_scope"
          },
          "authority_snapshot_path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^/"
          },
          "authority_snapshot_sha256": {
            "$ref": "#/$defs/sha256"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "cz_decision": {
            "const": "REJECT_FOR_TRAINING"
          }
        },
        "required": [
          "cz_decision"
        ]
      },
      "then": {
        "properties": {
          "decision_scope": {
            "const": "INTERNAL_MODEL_TRAINING"
          },
          "allowed_use": {
            "const": "FORBIDDEN"
          },
          "authority_document_path": {
            "type": "null"
          },
          "authority_document_sha256": {
            "type": "null"
          },
          "rights_holder": {
            "type": "null"
          },
          "validity": {
            "type": "null"
          },
          "cz_note": {
            "type": "string",
            "minLength": 1
          },
          "author_id": {
            "type": "null"
          },
          "author_name": {
            "type": "null"
          },
          "source_sha256": {
            "type": "null"
          },
          "row_scope": {
            "type": "null"
          },
          "authority_snapshot_path": {
            "type": "null"
          },
          "authority_snapshot_sha256": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "cz_decision": {
            "enum": [
              "CZ_DECISION_REQUIRED",
              "KEEP_RIGHTS_UNKNOWN"
            ]
          }
        },
        "required": [
          "cz_decision"
        ]
      },
      "then": {
        "properties": {
          "decision_scope": {
            "type": "null"
          },
          "authority_document_path": {
            "type": "null"
          },
          "authority_document_sha256": {
            "type": "null"
          },
          "rights_holder": {
            "type": "null"
          },
          "allowed_use": {
            "type": "null"
          },
          "validity": {
            "type": "null"
          },
          "author_id": {
            "type": "null"
          },
          "author_name": {
            "type": "null"
          },
          "source_sha256": {
            "type": "null"
          },
          "row_scope": {
            "type": "null"
          },
          "authority_snapshot_path": {
            "type": "null"
          },
          "authority_snapshot_sha256": {
            "type": "null"
          }
        }
      }
    }
  ]
}
