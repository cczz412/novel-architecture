    "frozen_m1_runner": {
      "authority": "P3_SOURCE_AND_EXECUTION_LOCK",
      "bytes": 31601,
      "check_schema_oracle": {
        "decorator_count": 0,
        "function_name": "check_schema",
        "global_dependencies": [
          "ALLOWED_STATUS",
          "ARMS",
          "Any",
          "all",
          "bool",
          "dict",
          "enumerate",
          "isinstance",
          "list",
          "set",
          "str",
          "tuple"
        ],
        "lineno_end": 488,
        "lineno_start": 462,
        "nested_function_count": 0,
        "oracle_name": "FROZEN_SOURCE_AST_ORACLE",
        "registered_ast_assignments": [
          "ALLOWED_STATUS",
          "ARMS['c2_full']['required']"
        ],
        "source_segment": "def check_schema(value: Any, arm: str) -> tuple[bool, list[str]]:\n    if not isinstance(value, dict) or set(value) != {\"facts\"} or not isinstance(value.get(\"facts\"), list):\n        return False, [\"top_level_facts_schema\"]\n    required = set(ARMS[arm][\"required\"])\n    errors = []\n    for index, item in enumerate(value[\"facts\"]):\n        if not isinstance(item, dict) or set(item) != required:\n            errors.append(f\"fact_{index}_keys\")\n            continue\n        if not isinstance(item.get(\"fact\"), str) or not item[\"fact\"]:\n            errors.append(f\"fact_{index}_fact\")\n        if item.get(\"status\") not in ALLOWED_STATUS:\n            errors.append(f\"fact_{index}_status\")\n        if item.get(\"speaker\") is not None and not isinstance(item.get(\"speaker\"), str):\n            errors.append(f\"fact_{index}_speaker\")\n        if arm == \"a_full\" and (not isinstance(item.get(\"evidence\"), str) or not item[\"evidence\"]):\n            errors.append(f\"fact_{index}_evidence\")\n        if arm == \"c2_full\" and (not isinstance(item.get(\"evidence_ids\"), list) or not all(isinstance(x, str) for x in item[\"evidence_ids\"])):\n            errors.append(f\"fact_{index}_evidence_ids\")\n        if arm == \"d_range\" and (not isinstance(item.get(\"evidence_ranges\"), list) or not all(isinstance(x, str) for x in item[\"evidence_ranges\"])):\n            errors.append(f\"fact_{index}_evidence_ranges\")\n        if arm == \"e_unit_quote\":\n            if not isinstance(item.get(\"unit_ids\"), list) or not all(isinstance(x, str) for x in item[\"unit_ids\"]):\n                errors.append(f\"fact_{index}_unit_ids\")\n            if not isinstance(item.get(\"quote\"), str) or not item[\"quote\"]:\n                errors.append(f\"fact_{index}_quote\")\n    return not errors, errors",
        "source_segment_sha256": "d640d941642bc80567a01dfd1595d2e4be44ac588a80f0214be67c0edfeba8b5"
      },
