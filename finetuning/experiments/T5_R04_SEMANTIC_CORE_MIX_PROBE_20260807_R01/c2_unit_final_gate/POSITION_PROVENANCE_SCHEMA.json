{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "t5-r04-canonical-a-position-provenance-v1",
  "type": "object",
  "required": [
    "canonical_sample_id",
    "fact_index",
    "fact_fingerprint_sha256",
    "source_text_sha256",
    "provenance_status",
    "eligible_for_unique_c2_mapping"
  ],
  "properties": {
    "canonical_sample_id": {"type": "string", "minLength": 1},
    "fact_index": {"type": "integer", "minimum": 1},
    "fact_fingerprint_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "evidence_text_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_text_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "coordinate_space": {"const": "c2_source_text_bridge_plus_target"},
    "indexing": {"const": "unicode_codepoint_0_based_half_open"},
    "char_start": {"type": "integer", "minimum": 0},
    "char_end": {"type": "integer", "minimum": 1},
    "provenance_status": {
      "enum": [
        "EXPLICIT_AT_ANNOTATION",
        "LEGACY_UNIQUE_TEXT_MATCH_BACKFILL",
        "LEGACY_POSITION_AMBIGUOUS"
      ]
    },
    "eligible_for_unique_c2_mapping": {"type": "boolean"},
    "candidate_ranges": {
      "type": "array",
      "items": {
        "type": "array",
        "prefixItems": [
          {"type": "integer", "minimum": 0},
          {"type": "integer", "minimum": 1}
        ],
        "minItems": 2,
        "maxItems": 2
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"eligible_for_unique_c2_mapping": {"const": true}}},
      "then": {"required": ["coordinate_space", "indexing", "char_start", "char_end", "evidence_text_sha256"]}
    },
    {
      "if": {"properties": {"provenance_status": {"const": "LEGACY_POSITION_AMBIGUOUS"}}},
      "then": {
        "properties": {"eligible_for_unique_c2_mapping": {"const": false}},
        "required": ["candidate_ranges"]
      }
    }
  ],
  "additionalProperties": false
}
