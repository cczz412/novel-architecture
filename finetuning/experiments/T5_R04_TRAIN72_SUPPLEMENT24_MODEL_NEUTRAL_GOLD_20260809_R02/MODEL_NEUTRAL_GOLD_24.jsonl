15"]},{"fact_id":"SUP16-F-02-F016","fact_sentence":"罗迦在交易中明确要求梦境“不流血、不伤人”。","status":"已发生","speaker":"罗迦","evidence_ids":["T15"]},{"fact_id":"SUP16-F-02-F017","fact_sentence":"图瓦在重述交易时省略了“不流血、不伤人”两项要求。","status":"已发生","speaker":null,"evidence_ids":["T16"]},{"fact_id":"SUP16-F-02-F018","fact_sentence":"行会允许梦境卖家借用买家的记忆塑造梦境。","status":"条件","speaker":null,"evidence_ids":["T16"]},{"fact_id":"SUP16-F-02-F019","fact_sentence":"行会禁止梦境卖家违背买家明说的边界。","status":"条件","speaker":null,"evidence_ids":["T16"]},{"fact_id":"SUP16-F-02-F020","fact_sentence":"买家若主动要求梦中对手具有面孔，就要承担记忆牵引的后果。","status":"条件","speaker":null,"evidence_ids":["T17"]},{"fact_id":"SUP16-F-02-F021","fact_sentence":"图瓦承认自己因赶宵禁只测试了梦境开头。","status":"已发生","speaker":"图瓦","evidence_ids":["T18"]},{"fact_id":"SUP16-F-02-F022","fact_sentence":"罗迦已支付两个安睡时辰；图瓦手中只剩一个，另一个昨晚已兑给送雾船。","status":"已发生","speaker":null,"evidence_ids":["T18","T19"]},{"fact_id":"SUP16-F-02-F023","fact_sentence":"图瓦若退还全部原价，当晚就无法开铺。","status":"条件","speaker":null,"evidence_ids":["T19"]},{"fact_id":"SUP16-F-02-F024","fact_sentence":"图瓦目前拿不出三个无梦夜。","status":"否定","speaker":null,"evidence_ids":["T19"]}],"exhaustive_within_target_candidate":true,"expected_fact_count":24}
