{"dataset_status":"CANDIDATE_NOT_YET_APPROVED","case_id":"TR72-M12","common_answer_entity_policy":"TARGET_VISIBLE_SURFACE_ONLY","facts":[{"fact_id":"TR72-M12-F001","fact_sentence":"第十七号航空箱的垫毯仍有余温和黑白长毛，箱内却已为空，电子屏仍标记麦芒已装车。","status":"已发生","speaker":null,"evidence_ids":["T04","T05","T06"]},{"fact_id":"TR72-M12-F002","fact_sentence":"女主人手里的红色牵引绳仍有绳扣，但连接胸背的那一截已经不见。","status":"已发生","speaker":null,"evidence_ids":["T09","T10"]},{"fact_id":"TR72-M12-F003","fact_sentence":"陆桥在空航空箱附近闻到消毒水之外的一点苦柑橘味。","status":"已发生","speaker":null,"evidence_ids":["T14"]},{"fact_id":"TR72-M12-F004","fact_sentence":"女主人称麦芒害怕柑橘清洁剂的味道，闻到后会躲到阳台一整天。","status":"条件","speaker":"女主人","evidence_ids":["T15","T16"]},{"fact_id":"TR72-M12-F005","fact_sentence":"女主人从登记以后一直没有离开候客区。","status":"推测","speaker":null,"evidence_ids":["T16","T17"]},{"fact_id":"TR72-M12-F006","fact_sentence":"陆桥要求厢车先别走。","status":"计划","speaker":"陆桥","evidence_ids":["T17"]},{"fact_id":"TR72-M12-F007","fact_sentence":"陆桥按下卷闸门并扣死东侧小门插销。","status":"已发生","speaker":null,"evidence_ids":["T19","T20"]},{"fact_id":"TR72-M12-F008","fact_sentence":"陆桥安排保安守住通往停车坪的侧廊。","status":"计划","speaker":"陆桥","evidence_ids":["T20"]},{"fact_id":"TR72-M12-F009","fact_sentence":"所有箱笼从厢车卸下复查后，麦芒仍不在车上。","status":"否定","speaker":null,"evidence_ids":["T21"]},{"fact_id":"TR72-M12-F010","fact_sentence":"现场迹象显示，麦芒也不像已经跑出中转站。","status":"推测","speaker":null,"evidence_ids":["T22"]}],"exhaustive_within_target_candidate":true,"expected_fact_count":10}
{"dataset_status":"CANDIDATE_NOT_YET_APPROVED","case_id":"TR72-M13","common_answer_entity_policy":"TARGET_VISIBLE_SURFACE_ONLY","facts":[{"fact_id":"TR72-M13-F001","fact_sentence":"谢明棠承诺辰时三刻按官定价格开仓，每户凭户牌限购两斤盐。","status":"承诺","speaker":"谢明棠","evidence_ids":["T06","T07"]},{"fact_id":"TR72-M13-F002","fact_sentence":"冯有庆称东家尚未同意开仓。","status":"否定","speaker":"冯有庆","evidence_ids":["T14","T15"]},{"fact_id":"TR72-M13-F003","fact_sentence":"谢明棠认为昨夜送到她手里的平码牌就是今日开仓的授权。","status":"推测","speaker":"谢明棠","evidence_ids":["T15","T16"]},{"fact_id":"TR72-M13-F004","fact_sentence":"冯有庆称河道已停船两日。","status":"已发生","speaker":"冯有庆","evidence_ids":["T16"]},{"fact_id":"TR72-M13-F005","fact_sentence":"冯有庆判断此时放盐会损失三成利润。","status":"推测","speaker":"冯有庆","evidence_ids":["T17"]},{"fact_id":"TR72-M13-F006","fact_sentence":"谢明棠判断丰泰若继续闭门，午前可能有人砸仓，若闹出人命还会招来多年官司。","status":"条件","speaker":"谢明棠","evidence_ids":["T18","T19"]},{"fact_id":"TR72-M13-F007","fact_sentence":"谢明棠决定打开正门放盐。","status":"计划","speaker":"谢明棠","evidence_ids":["T19"]},{"fact_id":"TR72-M13-F008","fact_sentence":"冯有庆称仓钥匙在大掌柜手里，而大掌柜已经去码头催船。","status":"已发生","speaker":"冯有庆","evidence_ids":["T20","T21"]}],"exhaustive_within_target_candidate":true,"expected_fact_count":8}
{"dataset_status":"CANDIDATE_NOT_YET_APPROVED","case_id":"TR72-M14","common_answer_entity_policy":"TARGET_VISIBLE_SURFACE_ONLY","facts":[{"fact_id":"TR72-M14-F001","fact_sentence":"鸬鹚号在凌晨三点十七分偏离了回收航线。","status":"已发生","speaker":null,"evidence_ids":["T01"]},{"fact_id":"TR72-M14-F002","fact_sentence":"周既白否认是自己操纵鸬鹚号改变航向。","status":"否定","speaker":"周既白","evidence_ids":["T07"]},{"fact_id":"TR72-M14-F003","fact_sentence":"周既白称已发三遍返航指令。","status":"已发生","speaker":"周既白","evidence_ids":["T07"]},{"fact_id":"TR72-M14-F004","fact_sentence":"鸬鹚号仍向东并已越过安全航道边线。","status":"正在发生","speaker":"周既白","evidence_ids":["T07","T08"]},{"fact_id":"TR72-M14-F005","fact_sentence":"若鸬鹚号继续前进四百米并让脐带缆挂上断崖岩柱，七吨重的潜器会把折光站拖向锚链外侧。","status":"条件","speaker":null,"evidence_ids":["T09","T10"]},{"fact_id":"TR72-M14-F006","fact_sentence":"手动转向时推进器延迟响应，鸬鹚号刚转向便又回到蓝光带方向；海流方向相反，因此不像水流顶偏。","status":"推测","speaker":null,"evidence_ids":["T12","T13","T14"]},{"fact_id":"TR72-M14-F007","fact_sentence":"蓝色光点经过镜头时会收暗一次，并始终保持在海床上方半米，不像发光水母那样随浪升降。","status":"已发生","speaker":null,"evidence_ids":["T15","T16"]},{"fact_id":"TR72-M14-F008","fact_sentence":"沈雁判断鸬鹚号正在追随蓝色光点。","status":"推测","speaker":"沈雁","evidence_ids":["T17"]},{"fact_id":"TR72-M14-F009","fact_sentence":"鸬鹚号每次左修正前，最亮光点都会先横移，潜器随即改向；关闭图像识别模块后它仍继续向东。","status":"已发生","speaker":null,"evidence_ids":["T18","T19","T20"]},{"fact_id":"TR72-M14-F010","fact_sentence":"周既白称主推进器仍服从他的操作，但转向指令正被其他指令压住。","status":"正在发生","speaker":"周既白","evidence_ids":["T21"]}],"exhaustive_within_target_candidate":true,"expected_fact_count":10}
{"dataset_status":"CANDIDATE_NOT_YET_APPROVED","case_id":"TR72-M15","common_answer_entity_policy":"TARGET_VISIBLE_SURFACE_ONLY","facts":[{"fact_id":"TR72-M15-F001","fact_sentence":"拳馆电子秤连续两次显示江岚体重为五十八点六公斤。","status":"已发生","speaker":null,"evidence_ids":["T01","T02"]},{"fact_id":"TR72-M15-F002","fact_sentence":"高桐称江岚四小时前用赛事秤称得五十七点四公斤，期间只喝了半瓶水，电子秤却多出一点二公斤。","status":"已发生","speaker":"高桐","evidence_ids":["T03","T04"]},{"fact_id":"TR72-M15-F003","fact_sentence":"次日新秀赛的五十七公斤级只允许上浮半公斤，超出一点二公斤无法靠脱衣物解决。","status":"条件","speaker":null,"evidence_ids":["T06","T07"]},{"fact_id":"TR72-M15-F004","fact_sentence":"江岚停赛两年后必须先通过本场称重并赢下比赛，才有资格进入省队年末选拔。","status":"条件","speaker":null,"evidence_ids":["T13","T14","T15"]},{"fact_id":"TR72-M15-F005","fact_sentence":"机械秤显示五十七点四公斤，江岚当天另外三次称重的照片也只相差一百克，异常只出现在赛事方借来的电子秤上。","status":"已发生","speaker":null,"evidence_ids":["T08","T09","T10","T11","T12"]},{"fact_id":"TR72-M15-F006","fact_sentence":"五百克校准砝码放在电子秤左角、右角和正中时，秤均显示五百四十克。","status":"已发生","speaker":null,"evidence_ids":["T16","T17"]},{"fact_id":"TR72-M15-F007","fact_sentence":"唐果称她下午把电子秤锁进器材柜后，钥匙一直在自己口袋里。","status":"已发生","speaker":"唐果","evidence_ids":["T19","T20"]},{"fact_id":"TR72-M15-F008","fact_sentence":"电子秤底部没有异常痕迹，电池仓的赛事组封签也保持完整。","status":"已发生","speaker":null,"evidence_ids":["T21","T22"]}],"exhaustive_within_target_candidate":true,"expected_fact_count":8}
{"dataset_status":"CANDIDATE_NOT_YET_APPROVED","case_id":"TR72-M16","common_answer_entity_policy":"TARGET_VISIBLE_SURFACE_ONLY","facts":[{"fact_id":"TR72-M16-F001","fact_sentence":"祁南判断全城缺失发生时，只有一副眼镜显示旧钟表厂地址，这很像有人故意留下的线索。","status":"推测","speaker":"祁南","evidence_ids":["T03"]},{"fact_id":"TR72-M16-F002","fact_sentence":"祁南计划先找不联网、也不依赖电子母钟的见证来源，再去旧钟表厂。","status":"计划","speaker":"祁南","evidence_ids":["T04","T05"]},{"fact_id":"TR72-M16-F003","fact_sentence":"盲人修表铺的磁带在电子世界缺失的十二秒内继续记录，并录下十二声报时轻响和一次沉闷撞击。","status":"已发生","speaker":null,"evidence_ids":["T07","T08","T09","T10"]},{"fact_id":"TR72-M16-F004","fact_sentence":"第一个未知男子在缺失的十二秒内说现场不是海堤路九号。","status":"否定","speaker":"未知男子甲","evidence_ids":["T11"]},{"fact_id":"TR72-M16-F005","fact_sentence":"第二个未知男子回答现场现在已经是海堤路九号。","status":"正在发生","speaker":"未知男子乙","evidence_ids":["T11","T12"]},{"fact_id":"TR72-M16-F006","fact_sentence":"祁南把磁带音频复制进隔离机，没有上传中心。","status":"已发生","speaker":null,"evidence_ids":["T14"]},{"fact_id":"TR72-M16-F007","fact_sentence":"祁南家门口摄像头在十七点四十二分零八秒至零二十秒离线十二秒。","status":"已发生","speaker":null,"evidence_ids":["T17","T18"]},{"fact_id":"TR72-M16-F008","fact_sentence":"祁南家距滨海隧道二十三公里。","status":"正在发生","speaker":null,"evidence_ids":["T18"]},{"fact_id":"TR72-M16-F009","fact_sentence":"祁南家走廊在缺失前无人，缺失后门垫上多出一只正在报时的发条报时器。","status":"已发生","speaker":null,"evidence_ids":["T18","T19"]}],"exhaustive_within_target_candidate":true,"expected_fact_count":9}
{"dataset_status":"CANDIDATE_NOT_YET_APPROVED","case_id":"TR72-M17","common_answer_entity_policy":"TARGET_VISIBLE_SURFACE_ONLY","facts":[{"fact_id":"TR72-M17-F001","fact_sentence":"十天前，废弃风筝线割伤了金雕右翼。","status":"已发生","speaker":null,"evidence_ids":["T02","T03"]},{"fact_id":"TR72-M17-F002","fact_sentence":"金雕右翼伤口现已收拢。","status":"正在发生","speaker":null,"evidence_ids":["T03","T04"]},{"fact_id":"TR72-M17-F003","fact_sentence":"金雕尚未完成最后一次负重飞行测试。","status":"否定","speaker":null,"evidence_ids":["T03","T04"]},{"fact_id":"TR72-M17-F004","fact_sentence":"救助站原计划在当天放归金雕。","status":"计划","speaker":null,"evidence_ids":["T04"]},{"fact_id":"TR72-M17-F005","fact_sentence":"韩杉报告北坡鞍口自六点四十分持续出现横风和低云，风向至少半小时未变，两只普通鵟都被压回林线。","status":"正在发生","speaker":"韩杉","evidence_ids":["T07","T08","T09","T10"]},{"fact_id":"TR72-M17-F006","fact_sentence":"夜间岩羊踩松了放归台附近的碎石。","status":"已发生","speaker":"韩杉","evidence_ids":["T10","T11"]},{"fact_id":"TR72-M17-F007","fact_sentence":"放归台目前人能站立，但运输箱不好抬。","status":"正在发生","speaker":"韩杉","evidence_ids":["T11"]},{"fact_id":"TR72-M17-F008","fact_sentence":"摄制组制片人坚持把拍摄地点改到林下。","status":"计划","speaker":"摄制组制片人","evidence_ids":["T12"]},{"fact_id":"TR72-M17-F009","fact_sentence":"雌性成年金雕早晨在东崖出现过一次。","status":"已发生","speaker":"韩杉","evidence_ids":["T13","T14"]},{"fact_id":"TR72-M17-F010","fact_sentence":"雄性成年金雕没有现身。","status":"否定","speaker":"韩杉","evidence_ids":["T14"]},{"fact_id":"TR72-M17-F011","fact_sentence":"成年金雕活动不完整只能说明附近仍有同类，不能证明当天适合放归。","status":"否定","speaker":null,"evidence_ids":["T14","T15"]},{"fact_id":"TR72-M17-F012","fact_sentence":"保护区负责人要求韩杉每十五分钟报告风和能见度，没有变化时也不得为配合拍摄美化情况。","status":"计划","speaker":"保护区负责人","evidence_ids":["T18","T19"]}],"exhaustive_within_target_candidate":true,"expected_fact_count":12}
