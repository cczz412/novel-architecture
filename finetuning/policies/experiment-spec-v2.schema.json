{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "finetuning-experiment-spec-v2",
  "type": "object",
  "required": [
    "schema_version",
    "experiment_id",
    "manifest_revision",
    "source_root",
    "state",
    "artifact_groups",
    "measurements",
    "assertions",
    "current_gate",
    "boundaries"
  ],
  "properties": {
    "schema_version": {"const": "finetuning-experiment-spec-v2"},
    "experiment_id": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+$"},
    "manifest_revision": {"type": "string", "minLength": 1},
    "source_root": {"type": "object"},
    "state": {"type": "object"},
    "artifact_groups": {"type": "array", "minItems": 1},
    "measurements": {"type": "object", "minProperties": 1},
    "assertions": {"type": "array"},
    "current_gate": {
      "type": "object",
      "required": ["required_receipts"],
      "properties": {
        "required_receipts": {"type": "array", "minItems": 1}
      },
      "additionalProperties": false
    },
    "boundaries": {"type": "object"}
  },
  "additionalProperties": false
}
