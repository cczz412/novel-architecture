{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.novel-mvp/contracts/KNOWLEDGE_EDGE.schema.json",
  "title": "KNOWLEDGE_EDGE knowledge-edge-v1",
  "description": "Project-level sparse character knowledge edges, trusted write actions, and least-privilege read grants.",
  "oneOf": [
    {"$ref": "#/$defs/edge"},
    {"$ref": "#/$defs/write_action"},
    {"$ref": "#/$defs/read_grant"}
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "chapter_revision_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["chapter_id", "revision_no", "revision_text_sha256"],
      "properties": {
        "chapter_id": {"type": "string", "pattern": "^c[0-9]{2,}$"},
        "revision_no": {"type": "integer", "minimum": 1},
        "revision_text_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "story_anchor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["chapter_revision_ref"],
      "properties": {
        "chapter_revision_ref": {"$ref": "#/$defs/chapter_revision_ref"},
        "story_order": {"type": "integer", "minimum": 0}
      }
    },
    "story_interval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {
        "start": {"$ref": "#/$defs/story_anchor"},
        "end": {
          "oneOf": [
            {"$ref": "#/$defs/story_anchor"},
            {"type": "null"}
          ]
        }
      }
    },
    "evidence_ref": {
      "oneOf": [
        {"type": "string", "pattern": "^f[0-9]{3,}$"},
        {"const": "AUTHOR_ATTESTATION"}
      ]
    },
    "version_status": {
      "type": "object",
      "additionalProperties": false,
      "required": ["confirmation", "lifecycle"],
      "properties": {
        "confirmation": {
          "type": "string",
          "enum": ["candidate", "author_confirmed"]
        },
        "lifecycle": {
          "type": "string",
          "enum": ["active", "retired"]
        }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract",
        "version",
        "id",
        "author_id",
        "project_id",
        "permission_namespace",
        "source_identity",
        "created_at",
        "updated_at",
        "rev",
        "previous_rev",
        "observer_ref",
        "epistemic_state",
        "fact_ref",
        "belief_content",
        "story_time_interval",
        "evidence_refs",
        "version_status"
      ],
      "properties": {
        "contract": {"const": "KNOWLEDGE_EDGE"},
        "version": {"const": "knowledge-edge-v1"},
        "id": {"type": "string", "pattern": "^KE-[0-9]+$"},
        "author_id": {"type": "string", "minLength": 1},
        "project_id": {"type": "string", "minLength": 1},
        "permission_namespace": {"const": "knowledge-edge.v1"},
        "source_identity": {
          "type": "string",
          "enum": ["author_declared", "draft_inferred", "model_suggested"]
        },
        "created_at": {"type": "string", "format": "date-time"},
        "updated_at": {"type": "string", "format": "date-time"},
        "rev": {"type": "integer", "minimum": 1},
        "previous_rev": {
          "oneOf": [
            {"type": "integer", "minimum": 1},
            {"type": "null"}
          ]
        },
        "observer_ref": {"type": "string", "pattern": "^CH-[0-9]+$"},
        "epistemic_state": {
          "type": "string",
          "enum": [
            "knows",
            "explicitly_does_not_know",
            "suspects",
            "false_belief"
          ]
        },
        "fact_ref": {"type": "string", "pattern": "^f[0-9]{3,}$"},
        "belief_content": {
          "oneOf": [
            {"type": "string", "minLength": 1, "maxLength": 500},
            {"type": "null"}
          ]
        },
        "story_time_interval": {"$ref": "#/$defs/story_interval"},
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/evidence_ref"}
        },
        "version_status": {"$ref": "#/$defs/version_status"}
      },
      "allOf": [
        {
          "if": {
            "properties": {"epistemic_state": {"const": "false_belief"}},
            "required": ["epistemic_state"]
          },
          "then": {
            "properties": {
              "belief_content": {"type": "string", "minLength": 1, "maxLength": 500}
            }
          },
          "else": {
            "properties": {"belief_content": {"type": "null"}}
          }
        }
      ]
    },
    "write_action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract",
        "version",
        "action_id",
        "author_id",
        "project_id",
        "writer_namespace",
        "operation",
        "requested_by",
        "edge_id",
        "base_rev",
        "idempotency_key"
      ],
      "properties": {
        "contract": {"const": "KNOWLEDGE_EDGE_WRITE_ACTION"},
        "version": {"const": "knowledge-edge-v1"},
        "action_id": {"type": "string", "pattern": "^KEA-[A-Za-z0-9._:-]+$"},
        "author_id": {"type": "string", "minLength": 1},
        "project_id": {"type": "string", "minLength": 1},
        "writer_namespace": {"const": "trusted.knowledge_edge.writer.v1"},
        "operation": {
          "type": "string",
          "enum": ["PROPOSE_CANDIDATE", "CONFIRM", "MODIFY", "RETIRE"]
        },
        "requested_by": {"type": "string", "enum": ["MODEL", "AUTHOR"]},
        "edge_id": {
          "oneOf": [
            {"type": "string", "pattern": "^KE-[0-9]+$"},
            {"type": "null"}
          ]
        },
        "base_rev": {
          "oneOf": [
            {"type": "integer", "minimum": 1},
            {"type": "null"}
          ]
        },
        "idempotency_key": {"type": "string", "minLength": 1}
      }
    },
    "read_grant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract",
        "version",
        "grant_id",
        "author_id",
        "project_id",
        "permission_namespace",
        "permission_policy_version",
        "principal_kind",
        "access",
        "observer_refs",
        "fact_refs",
        "as_of"
      ],
      "properties": {
        "contract": {"const": "KNOWLEDGE_EDGE_READ_GRANT"},
        "version": {"const": "knowledge-edge-v1"},
        "grant_id": {"type": "string", "pattern": "^KEG-[A-Za-z0-9._:-]+$"},
        "author_id": {"type": "string", "minLength": 1},
        "project_id": {"type": "string", "minLength": 1},
        "permission_namespace": {"const": "knowledge-edge.v1"},
        "permission_policy_version": {"type": "string", "minLength": 1},
        "principal_kind": {
          "type": "string",
          "enum": ["AUTHOR", "MAIN_AI", "POV_CHECKER", "CHAPTER_CARD", "READER", "PLUGIN"]
        },
        "access": {"type": "string", "enum": ["FULL_PROJECT", "TASK_SLICE", "CLOSED"]},
        "observer_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^CH-[0-9]+$"}
        },
        "fact_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^f[0-9]{3,}$"}
        },
        "as_of": {
          "oneOf": [
            {"$ref": "#/$defs/story_anchor"},
            {"type": "null"}
          ]
        }
      }
    }
  }
}
