{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.novel-mvp/contracts/LOCATION_LEDGER_CONTENT.schema.json",
  "title": "LOCATION_LEDGER_CONTENT location-ledger-content-v1",
  "description": "Location definition plus evidence-bound state read projections.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "version",
    "id",
    "source_identity",
    "confirm_status",
    "evidence_refs",
    "story_time",
    "created_at",
    "updated_at",
    "rev",
    "note",
    "name",
    "aliases",
    "loc_type",
    "parent_ref",
    "profile",
    "state_timeline"
  ],
  "properties": {
    "contract": {
      "const": "LOCATION_LEDGER_CONTENT"
    },
    "version": {
      "const": "location-ledger-content-v1"
    },
    "id": {
      "type": "string",
      "pattern": "^LOC\\-[0-9]+$"
    },
    "source_identity": {
      "enum": [
        "author_declared",
        "draft_inferred",
        "model_suggested",
        "pack_prefilled"
      ]
    },
    "confirm_status": {
      "enum": [
        "candidate",
        "confirmed",
        "retired"
      ]
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence_ref"
      },
      "uniqueItems": true
    },
    "story_time": {
      "type": "null"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "rev": {
      "type": "integer",
      "minimum": 1
    },
    "note": {
      "type": "string"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "aliases": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/alias_entry"
      }
    },
    "loc_type": {
      "type": "string",
      "minLength": 1
    },
    "parent_ref": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^LOC-[0-9]+$"
        },
        {
          "type": "null"
        }
      ]
    },
    "profile": {
      "type": "string",
      "minLength": 1
    },
    "state_timeline": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/state_entry"
      }
    }
  },
  "$defs": {
    "evidence_ref": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^f[0-9]{3,}$"
        },
        {
          "const": "AUTHOR_ATTESTATION"
        }
      ]
    },
    "evidence_refs_nonempty": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/evidence_ref"
      },
      "uniqueItems": true
    },
    "chapter_revision_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "chapter_id",
        "revision_no",
        "revision_text_sha256"
      ],
      "properties": {
        "chapter_id": {
          "type": "string",
          "pattern": "^c[0-9]{2,}$"
        },
        "revision_no": {
          "type": "integer",
          "minimum": 1
        },
        "revision_text_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "story_anchor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "chapter_revision_ref"
      ],
      "properties": {
        "chapter_revision_ref": {
          "$ref": "#/$defs/chapter_revision_ref"
        },
        "story_order": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "story_interval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start",
        "end"
      ],
      "properties": {
        "start": {
          "$ref": "#/$defs/story_anchor"
        },
        "end": {
          "oneOf": [
            {
              "$ref": "#/$defs/story_anchor"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "alias_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "story_time",
        "evidence_refs"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "story_time": {
          "$ref": "#/$defs/story_interval"
        },
        "evidence_refs": {
          "$ref": "#/$defs/evidence_refs_nonempty"
        }
      }
    },
    "state_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "loc_ref",
        "state_key",
        "value",
        "story_time",
        "evidence_refs"
      ],
      "properties": {
        "loc_ref": {
          "type": "string",
          "pattern": "^LOC-[0-9]+$"
        },
        "state_key": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": "string",
          "minLength": 1
        },
        "story_time": {
          "$ref": "#/$defs/story_interval"
        },
        "evidence_refs": {
          "$ref": "#/$defs/evidence_refs_nonempty"
        }
      }
    }
  }
}
