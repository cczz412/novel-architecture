{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.novel-mvp/contracts/CHARACTER_LEDGER_CONTENT.schema.json",
  "title": "CHARACTER_LEDGER_CONTENT character-ledger-content-v1.1 / character-ledger-content-v2",
  "description": "Character definition card plus evidence-bound state, relationships, and four collapsible in-book sequences (desire/ordeal/intent/choice). Version v1 remains readable; v2 requires namespaced tags and tag_groups.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "version",
    "id",
    "source_identity",
    "confirm_status",
    "evidence_refs",
    "story_time",
    "created_at",
    "updated_at",
    "rev",
    "note",
    "canonical_name",
    "aliases",
    "role_tag",
    "profile",
    "visibility",
    "destiny_ref",
    "state_timeline",
    "relationships",
    "desire_seq",
    "ordeal_seq",
    "intent_seq",
    "choice_seq"
  ],
  "properties": {
    "contract": {
      "const": "CHARACTER_LEDGER_CONTENT"
    },
    "version": {
      "enum": [
        "character-ledger-content-v1.1",
        "character-ledger-content-v2"
      ]
    },
    "id": {
      "type": "string",
      "pattern": "^CH-[0-9]+$"
    },
    "source_identity": {
      "type": "string",
      "enum": [
        "author_declared",
        "draft_inferred",
        "model_suggested",
        "pack_prefilled"
      ]
    },
    "confirm_status": {
      "type": "string",
      "enum": [
        "candidate",
        "confirmed",
        "retired"
      ]
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence_ref"
      },
      "uniqueItems": true
    },
    "story_time": {
      "type": "null"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "rev": {
      "type": "integer",
      "minimum": 1
    },
    "note": {
      "type": "string"
    },
    "canonical_name": {
      "type": "string",
      "minLength": 1
    },
    "aliases": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/alias_entry"
      }
    },
    "role_tag": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "profile": {
      "type": "string",
      "minLength": 1
    },
    "visibility": {
      "type": "string",
      "enum": [
        "AUTHOR",
        "READER_RELEASED"
      ]
    },
    "destiny_ref": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "state_timeline": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/state_entry"
      }
    },
    "relationships": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/relationship_entry"
      }
    },
    "desire_seq": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/desire_entry"
      }
    },
    "ordeal_seq": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ordeal_entry"
      }
    },
    "intent_seq": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/intent_entry"
      }
    },
    "choice_seq": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/choice_entry"
      }
    },
    "tags": {
      "$ref": "#/$defs/tags"
    },
    "tag_groups": {
      "$ref": "#/$defs/tag_groups"
    }
  },
  "$defs": {
    "evidence_ref": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^f[0-9]{3,}$"
        },
        {
          "const": "AUTHOR_ATTESTATION"
        }
      ]
    },
    "evidence_refs_nonempty": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/evidence_ref"
      },
      "uniqueItems": true
    },
    "chapter_revision_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "chapter_id",
        "revision_no",
        "revision_text_sha256"
      ],
      "properties": {
        "chapter_id": {
          "type": "string",
          "pattern": "^c[0-9]{2,}$"
        },
        "revision_no": {
          "type": "integer",
          "minimum": 1
        },
        "revision_text_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "story_anchor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "chapter_revision_ref"
      ],
      "properties": {
        "chapter_revision_ref": {
          "$ref": "#/$defs/chapter_revision_ref"
        },
        "story_order": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "story_interval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start",
        "end"
      ],
      "properties": {
        "start": {
          "$ref": "#/$defs/story_anchor"
        },
        "end": {
          "oneOf": [
            {
              "$ref": "#/$defs/story_anchor"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "alias_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "story_time",
        "evidence_refs"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "story_time": {
          "$ref": "#/$defs/story_interval"
        },
        "evidence_refs": {
          "$ref": "#/$defs/evidence_refs_nonempty"
        }
      }
    },
    "state_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ch_ref",
        "state_key",
        "value",
        "story_time",
        "evidence_refs"
      ],
      "properties": {
        "ch_ref": {
          "type": "string",
          "pattern": "^CH-[0-9]+$"
        },
        "state_key": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": "string",
          "minLength": 1
        },
        "story_time": {
          "$ref": "#/$defs/story_interval"
        },
        "evidence_refs": {
          "$ref": "#/$defs/evidence_refs_nonempty"
        }
      }
    },
    "relationship_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_ref",
        "kind",
        "story_time",
        "evidence_refs"
      ],
      "properties": {
        "target_ref": {
          "type": "string",
          "pattern": "^CH-[0-9]+$"
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "story_time": {
          "$ref": "#/$defs/story_interval"
        },
        "evidence_refs": {
          "$ref": "#/$defs/evidence_refs_nonempty"
        }
      }
    },
    "fact_ref": {
      "type": "string",
      "pattern": "^f[0-9]{3,}$"
    },
    "nullable_fact_ref": {
      "oneOf": [
        {
          "$ref": "#/$defs/fact_ref"
        },
        {
          "type": "null"
        }
      ]
    },
    "desire_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "subject_ref",
        "content",
        "status",
        "source_fact_ref",
        "achieved_fact_ref",
        "next_desire_ref"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^DESIRE-[0-9]+$"
        },
        "subject_ref": {
          "type": "string",
          "pattern": "^CH-[0-9]+$"
        },
        "content": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "活跃",
            "达成",
            "放弃",
            "转化"
          ]
        },
        "source_fact_ref": {
          "$ref": "#/$defs/fact_ref"
        },
        "achieved_fact_ref": {
          "$ref": "#/$defs/nullable_fact_ref"
        },
        "next_desire_ref": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^DESIRE-[0-9]+$"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "ordeal_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "subject_ref",
        "content",
        "status",
        "source_fact_ref",
        "resolved_fact_ref"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^ORDEAL-[0-9]+$"
        },
        "subject_ref": {
          "type": "string",
          "pattern": "^CH-[0-9]+$"
        },
        "content": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "持续",
            "恶化",
            "解除"
          ]
        },
        "source_fact_ref": {
          "$ref": "#/$defs/fact_ref"
        },
        "resolved_fact_ref": {
          "$ref": "#/$defs/nullable_fact_ref"
        }
      }
    },
    "intent_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "subject_ref",
        "content",
        "status",
        "scope",
        "source_fact_ref",
        "fulfilled_fact_ref"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^INTENT-[0-9]+$"
        },
        "subject_ref": {
          "type": "string",
          "pattern": "^CH-[0-9]+$"
        },
        "content": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "未执行",
            "执行中",
            "兑现",
            "落空",
            "放弃"
          ]
        },
        "scope": {
          "const": "in_book_character"
        },
        "source_fact_ref": {
          "$ref": "#/$defs/fact_ref"
        },
        "fulfilled_fact_ref": {
          "$ref": "#/$defs/nullable_fact_ref"
        }
      }
    },
    "choice_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "subject_ref",
        "faced",
        "chosen",
        "cost",
        "source_fact_ref"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^CHOICE-[0-9]+$"
        },
        "subject_ref": {
          "type": "string",
          "pattern": "^CH-[0-9]+$"
        },
        "faced": {
          "type": "string",
          "minLength": 1
        },
        "chosen": {
          "type": "string",
          "minLength": 1
        },
        "cost": {
          "type": "string"
        },
        "source_fact_ref": {
          "$ref": "#/$defs/fact_ref"
        }
      }
    },
    "tag": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*:[a-z][a-z0-9._-]*$"
    },
    "tag_group": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "group_id",
        "members",
        "targets",
        "mutation",
        "transition_rule",
        "access",
        "mask_for",
        "managed_by"
      ],
      "properties": {
        "group_id": {
          "$ref": "#/$defs/tag"
        },
        "members": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/tag"
          },
          "uniqueItems": true
        },
        "targets": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^/[A-Za-z][A-Za-z0-9_./-]*$"
          },
          "uniqueItems": true
        },
        "mutation": {
          "type": "string",
          "enum": [
            "editable",
            "write_once",
            "frozen",
            "transition_only"
          ]
        },
        "transition_rule": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "minLength": 1
            }
          ]
        },
        "access": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "read",
            "write"
          ],
          "properties": {
            "read": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "enum": [
                  "AUTHOR",
                  "MODEL",
                  "READER",
                  "PLUGIN",
                  "SYSTEM"
                ]
              },
              "uniqueItems": true
            },
            "write": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "enum": [
                  "AUTHOR",
                  "MODEL",
                  "READER",
                  "PLUGIN",
                  "SYSTEM"
                ]
              },
              "uniqueItems": true
            }
          }
        },
        "mask_for": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "model_context",
              "reader_view",
              "plugin"
            ]
          },
          "uniqueItems": true
        },
        "managed_by": {
          "type": "string",
          "enum": [
            "CONTRACT",
            "AUTHOR",
            "PLUGIN"
          ]
        }
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/tag"
      },
      "uniqueItems": true
    },
    "tag_groups": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rules_version",
        "groups"
      ],
      "properties": {
        "rules_version": {
          "const": "tag-group-rules-v1"
        },
        "groups": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/tag_group"
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "version"
        ],
        "properties": {
          "version": {
            "const": "character-ledger-content-v2"
          }
        }
      },
      "then": {
        "required": [
          "tags",
          "tag_groups"
        ]
      },
      "else": {
        "not": {
          "anyOf": [
            {
              "required": [
                "tags"
              ]
            },
            {
              "required": [
                "tag_groups"
              ]
            }
          ]
        }
      }
    }
  ]
}
