{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://novel-architecture.local/contracts/chapter-thin-card-acceptance-v1.schema.json",
  "title": "CHAPTER_THIN_CARD_ACCEPTANCE contract family v1",
  "oneOf": [
    {"$ref": "#/$defs/acceptance_case"},
    {"$ref": "#/$defs/suite_receipt"}
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "stable_string": {
      "type": "string",
      "minLength": 1
    },
    "string_array": {
      "type": "array",
      "items": {"$ref": "#/$defs/stable_string"},
      "uniqueItems": true
    },
    "scenario_id": {
      "type": "string",
      "pattern": "^A(0[1-9]|1[0-2])$"
    },
    "case_id": {
      "type": "string",
      "pattern": "^A(0[1-9]|1[0-2])(-NEG)?$"
    },
    "reader_limit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_business_items", "unit"],
      "properties": {
        "max_business_items": {"const": 100},
        "unit": {"const": "BUSINESS_ITEMS"}
      }
    },
    "thin_card_limit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_payload_bytes", "unit"],
      "properties": {
        "max_payload_bytes": {"const": 262144},
        "unit": {"const": "CANONICAL_JSON_UTF8_BYTES"}
      }
    },
    "input_recipe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "thin_card_fixture_refs",
        "generated_variants",
        "external_calls_allowed"
      ],
      "properties": {
        "thin_card_fixture_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^CTC-(VALID|INVALID)-[0-9]{2}$"
          },
          "uniqueItems": true
        },
        "generated_variants": {"$ref": "#/$defs/string_array"},
        "external_calls_allowed": {"const": false}
      }
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_contracts",
        "admission_disposition",
        "source_state",
        "reader_limit",
        "thin_card_limit"
      ],
      "properties": {
        "artifact_contracts": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "CHAPTER_THIN_CARD",
              "CHAPTER_THIN_CARD_ADMISSION_RECEIPT",
              "CHAPTER_THIN_CARD_BUILD_FAILURE",
              "NO_SUCCESS_CARD"
            ]
          }
        },
        "admission_disposition": {
          "enum": [
            "ADMITTED",
            "ADMITTED_WITH_GAPS",
            "STOPPED",
            "MIXED_BY_STAGE",
            "RECHECK_ON_GENERATION_CHANGE"
          ]
        },
        "source_state": {
          "type": ["string", "null"],
          "enum": [
            "PRESENT",
            "EMPTY",
            "NO_MATCH",
            "UNTRACKED",
            "UNAUTHORIZED",
            null
          ]
        },
        "reader_limit": {"$ref": "#/$defs/reader_limit"},
        "thin_card_limit": {"$ref": "#/$defs/thin_card_limit"}
      }
    },
    "negative_variant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mutation", "expected_error_code"],
      "properties": {
        "mutation": {"$ref": "#/$defs/stable_string"},
        "expected_error_code": {
          "type": "string",
          "pattern": "^A(0[1-9]|1[0-2])_[A-Z0-9_]+$"
        }
      }
    },
    "acceptance_case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract",
        "version",
        "case_id",
        "scenario_id",
        "title",
        "synthetic_only",
        "input_recipe",
        "expected",
        "assertion_ids",
        "negative_variant",
        "case_sha256"
      ],
      "properties": {
        "contract": {"const": "CHAPTER_THIN_CARD_ACCEPTANCE_CASE"},
        "version": {"const": "v1"},
        "case_id": {"$ref": "#/$defs/case_id"},
        "scenario_id": {"$ref": "#/$defs/scenario_id"},
        "title": {"$ref": "#/$defs/stable_string"},
        "synthetic_only": {"const": true},
        "input_recipe": {"$ref": "#/$defs/input_recipe"},
        "expected": {"$ref": "#/$defs/expected"},
        "assertion_ids": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^A(0[1-9]|1[0-2])-[A-Z0-9-]+$"
          }
        },
        "negative_variant": {"$ref": "#/$defs/negative_variant"},
        "case_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "case_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_id", "status", "assertion_ids", "case_sha256"],
      "properties": {
        "case_id": {"$ref": "#/$defs/scenario_id"},
        "status": {"const": "PASS"},
        "assertion_ids": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/stable_string"}
        },
        "case_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "negative_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_id", "status", "error_code"],
      "properties": {
        "case_id": {
          "type": "string",
          "pattern": "^A(0[1-9]|1[0-2])-NEG$"
        },
        "status": {"const": "REJECTED_AS_EXPECTED"},
        "error_code": {
          "type": "string",
          "pattern": "^A(0[1-9]|1[0-2])_[A-Z0-9_]+$"
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reader_max_business_items",
        "reader_unit",
        "thin_card_max_payload_bytes",
        "thin_card_unit"
      ],
      "properties": {
        "reader_max_business_items": {"const": 100},
        "reader_unit": {"const": "BUSINESS_ITEMS"},
        "thin_card_max_payload_bytes": {"const": 262144},
        "thin_card_unit": {"const": "CANONICAL_JSON_UTF8_BYTES"}
      }
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^(CHAPTER|LEDGER|validate_).+\\.(json|py)$"
        },
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "call_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "business_file_reads",
        "database_calls",
        "network_calls",
        "model_calls",
        "real_reader_calls",
        "real_c9_calls",
        "ui_calls"
      ],
      "properties": {
        "business_file_reads": {"const": 0},
        "database_calls": {"const": 0},
        "network_calls": {"const": 0},
        "model_calls": {"const": 0},
        "real_reader_calls": {"const": 0},
        "real_c9_calls": {"const": 0},
        "ui_calls": {"const": 0}
      }
    },
    "suite_receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract",
        "version",
        "suite_receipt_id",
        "status",
        "scenario_ids",
        "case_results",
        "negative_variant_results",
        "limits",
        "dependency_manifest",
        "call_counts",
        "receipt_sha256"
      ],
      "properties": {
        "contract": {"const": "CHAPTER_THIN_CARD_ACCEPTANCE_SUITE_RECEIPT"},
        "version": {"const": "v1"},
        "suite_receipt_id": {
          "const": "CHAPTER-THIN-CARD-ACCEPTANCE-SUITE-0001"
        },
        "status": {"const": "PASS"},
        "scenario_ids": {
          "type": "array",
          "minItems": 12,
          "maxItems": 12,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/scenario_id"}
        },
        "case_results": {
          "type": "array",
          "minItems": 12,
          "maxItems": 12,
          "items": {"$ref": "#/$defs/case_result"}
        },
        "negative_variant_results": {
          "type": "array",
          "minItems": 12,
          "maxItems": 12,
          "items": {"$ref": "#/$defs/negative_result"}
        },
        "limits": {"$ref": "#/$defs/limits"},
        "dependency_manifest": {
          "type": "array",
          "minItems": 8,
          "maxItems": 8,
          "items": {"$ref": "#/$defs/dependency"}
        },
        "call_counts": {"$ref": "#/$defs/call_counts"},
        "receipt_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
