{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.novel-mvp/contracts/CHAPTER_LAYERED_SUMMARY.schema.json",
  "title": "CHAPTER_LAYERED_SUMMARY v1",
  "description": "Traceable phase or long-range projection over chapter settlement seals.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "version",
    "truth_scope_ref",
    "claim_kind",
    "summary_kind",
    "projection_only",
    "writes_truth",
    "scope",
    "policy",
    "inputs",
    "leaf_settlement_refs",
    "sections",
    "unresolved_item_refs",
    "coverage",
    "generated_by",
    "generated_at",
    "summary_sha256"
  ],
  "properties": {
    "contract": {"const": "CHAPTER_LAYERED_SUMMARY"},
    "version": {"const": "v1"},
    "truth_scope_ref": {"$ref": "#/$defs/truth_scope_ref"},
    "claim_kind": {
      "enum": ["RESOLVED_PROJECTION", "OWNER_UNRESOLVED_PROJECTION"]
    },
    "summary_kind": {"enum": ["PHASE", "LONG_RANGE"]},
    "projection_only": {"const": true},
    "writes_truth": {"const": false},
    "scope": {"$ref": "#/$defs/scope"},
    "policy": {"$ref": "#/$defs/policy"},
    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/input_ref"}
    },
    "leaf_settlement_refs": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/leaf_ref"}
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/section"}
    },
    "unresolved_item_refs": {
      "type": "array",
      "items": {"$ref": "#/$defs/unresolved_item_ref"}
    },
    "coverage": {"$ref": "#/$defs/coverage"},
    "generated_by": {"$ref": "#/$defs/generated_by"},
    "generated_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "summary_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "non_empty_string": {"type": "string", "minLength": 1},
    "truth_scope_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["principal_author_id", "project_id"],
      "properties": {
        "principal_author_id": {"$ref": "#/$defs/non_empty_string"},
        "project_id": {"$ref": "#/$defs/non_empty_string"}
      }
    },
    "grouping_basis": {
      "enum": [
        "STORY_PHASE",
        "STORYLINE_SCOPE",
        "VOLUME_SCOPE",
        "AUTHOR_PINNED_SET",
        "OTHER_REGISTERED_POLICY"
      ]
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["grouping_basis", "scope_ref", "ordered"],
      "properties": {
        "grouping_basis": {"$ref": "#/$defs/grouping_basis"},
        "scope_ref": {"$ref": "#/$defs/non_empty_string"},
        "ordered": {"const": true}
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy_id", "policy_version", "grouping_basis", "policy_sha256"],
      "properties": {
        "policy_id": {"$ref": "#/$defs/non_empty_string"},
        "policy_version": {"$ref": "#/$defs/non_empty_string"},
        "grouping_basis": {"$ref": "#/$defs/grouping_basis"},
        "policy_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "input_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input_kind", "input_sha256", "input_claim_kind", "order"],
      "properties": {
        "input_kind": {"enum": ["CHAPTER_SETTLEMENT_SEAL", "CHAPTER_LAYERED_SUMMARY"]},
        "input_sha256": {"$ref": "#/$defs/sha256"},
        "input_claim_kind": {
          "enum": [
            "OWNER_RESOLVED_SEALED",
            "OWNER_UNRESOLVED_CANDIDATE",
            "RESOLVED_PROJECTION",
            "OWNER_UNRESOLVED_PROJECTION"
          ]
        },
        "order": {"type": "integer", "minimum": 1}
      }
    },
    "leaf_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slot_ref", "settlement_sha256", "settlement_claim_kind", "order"],
      "properties": {
        "slot_ref": {"$ref": "#/$defs/non_empty_string"},
        "settlement_sha256": {"$ref": "#/$defs/sha256"},
        "settlement_claim_kind": {
          "enum": ["OWNER_RESOLVED_SEALED", "OWNER_UNRESOLVED_CANDIDATE"]
        },
        "order": {"type": "integer", "minimum": 1}
      }
    },
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": ["section_id", "section_kind", "summary", "source_leaf_settlement_refs"],
      "properties": {
        "section_id": {"$ref": "#/$defs/non_empty_string"},
        "section_kind": {"enum": ["SYNOPSIS", "KEY_CHANGE", "UNRESOLVED", "HANDOFF"]},
        "summary": {"$ref": "#/$defs/non_empty_string"},
        "source_leaf_settlement_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/sha256"}
        }
      }
    },
    "unresolved_item_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["item_id", "settlement_sha256"],
      "properties": {
        "item_id": {"$ref": "#/$defs/non_empty_string"},
        "settlement_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_count",
        "leaf_count",
        "covered_leaf_count",
        "unresolved_item_count",
        "coverage_ratio"
      ],
      "properties": {
        "input_count": {"type": "integer", "minimum": 1},
        "leaf_count": {"type": "integer", "minimum": 1},
        "covered_leaf_count": {"type": "integer", "minimum": 1},
        "unresolved_item_count": {"type": "integer", "minimum": 0},
        "coverage_ratio": {"const": 1.0}
      }
    },
    "generated_by": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "name", "version"],
      "properties": {
        "kind": {"enum": ["DETERMINISTIC_ASSEMBLER", "MODEL_CANDIDATE"]},
        "name": {"$ref": "#/$defs/non_empty_string"},
        "version": {"$ref": "#/$defs/non_empty_string"}
      }
    }
  }
}
