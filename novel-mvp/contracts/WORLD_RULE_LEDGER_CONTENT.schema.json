{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.novel-mvp/contracts/WORLD_RULE_LEDGER_CONTENT.schema.json",
  "title": "WORLD_RULE_LEDGER_CONTENT world-rule-ledger-content-v1",
  "description": "World rule definition card and M7 red-light eligibility precondition.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "version",
    "id",
    "source_identity",
    "confirm_status",
    "evidence_refs",
    "story_time",
    "created_at",
    "updated_at",
    "rev",
    "note",
    "rule_text",
    "scope",
    "hardness",
    "exceptions"
  ],
  "properties": {
    "contract": {
      "const": "WORLD_RULE_LEDGER_CONTENT"
    },
    "version": {
      "const": "world-rule-ledger-content-v1"
    },
    "id": {
      "type": "string",
      "pattern": "^RU-[0-9]+$"
    },
    "source_identity": {
      "enum": [
        "author_declared",
        "draft_inferred",
        "model_suggested",
        "pack_prefilled"
      ]
    },
    "confirm_status": {
      "enum": [
        "candidate",
        "confirmed",
        "retired"
      ]
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence_ref"
      },
      "uniqueItems": true
    },
    "story_time": {
      "type": "null"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "rev": {
      "type": "integer",
      "minimum": 1
    },
    "note": {
      "type": "string"
    },
    "rule_text": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "hardness": {
      "enum": [
        "hard",
        "advisory"
      ]
    },
    "exceptions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    }
  },
  "$defs": {
    "evidence_ref": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^f[0-9]{3,}$"
        },
        {
          "const": "AUTHOR_ATTESTATION"
        }
      ]
    }
  }
}
