{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.novel-mvp/contracts/CHAPTER_SETTLEMENT_SEAL.schema.json",
  "title": "CHAPTER_SETTLEMENT_SEAL v1",
  "description": "Project-scoped chapter settlement record. Structural validation only.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "version",
    "truth_scope_ref",
    "claim_kind",
    "slot_ref",
    "settled_at",
    "closeout_input",
    "manuscript",
    "planning",
    "outcome",
    "ledger_coverage",
    "unresolved_story_items",
    "next_chapter_handoff",
    "provenance_seals",
    "settlement_sha256"
  ],
  "properties": {
    "contract": {"const": "CHAPTER_SETTLEMENT_SEAL"},
    "version": {"const": "v1"},
    "truth_scope_ref": {"$ref": "#/$defs/truth_scope_ref"},
    "claim_kind": {
      "enum": ["OWNER_RESOLVED_SEALED", "OWNER_UNRESOLVED_CANDIDATE"]
    },
    "slot_ref": {"$ref": "#/$defs/non_empty_string"},
    "settled_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "closeout_input": {"$ref": "#/$defs/closeout_input"},
    "manuscript": {"$ref": "#/$defs/manuscript"},
    "planning": {"$ref": "#/$defs/planning"},
    "outcome": {"$ref": "#/$defs/outcome"},
    "ledger_coverage": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": {"$ref": "#/$defs/ledger_result"}
    },
    "unresolved_story_items": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/unresolved_story_item"}
    },
    "next_chapter_handoff": {"$ref": "#/$defs/next_chapter_handoff"},
    "provenance_seals": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["contract", "version", "truth_scope_ref", "seal_sha256"]
      }
    },
    "settlement_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "non_empty_string": {"type": "string", "minLength": 1},
    "nullable_string": {
      "oneOf": [{"$ref": "#/$defs/non_empty_string"}, {"type": "null"}]
    },
    "truth_scope_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["principal_author_id", "project_id"],
      "properties": {
        "principal_author_id": {"$ref": "#/$defs/non_empty_string"},
        "project_id": {"$ref": "#/$defs/non_empty_string"}
      }
    },
    "closeout_input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract",
        "version",
        "operation_id",
        "actor",
        "slot_ref",
        "route",
        "work_ref",
        "work_rev",
        "check_result_ref",
        "action_sha256"
      ],
      "properties": {
        "contract": {"const": "WRITING_DESK_CLOSEOUT_ACTION"},
        "version": {"const": "v1"},
        "operation_id": {"$ref": "#/$defs/non_empty_string"},
        "actor": {"const": "author"},
        "slot_ref": {"$ref": "#/$defs/non_empty_string"},
        "route": {"enum": ["full_check", "skip_check", "no_prose"]},
        "work_ref": {"$ref": "#/$defs/nullable_string"},
        "work_rev": {
          "oneOf": [{"type": "integer", "minimum": 1}, {"type": "null"}]
        },
        "check_result_ref": {"$ref": "#/$defs/nullable_string"},
        "action_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "chapter_revision_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["chapter_id", "revision_no", "revision_text_sha256"],
      "properties": {
        "chapter_id": {"type": "string", "pattern": "^c[0-9]{2,}$"},
        "revision_no": {"type": "integer", "minimum": 1},
        "revision_text_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "handover_receipt_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation_id", "receipt_sha256"],
      "properties": {
        "operation_id": {"$ref": "#/$defs/non_empty_string"},
        "receipt_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "manuscript": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "disposition",
        "chapter_revision_ref",
        "handover_receipt_ref",
        "written_progress_delta",
        "provenance_seal_refs"
      ],
      "properties": {
        "disposition": {"enum": ["ADOPTED_C11", "NOT_ADOPTED", "NO_PROSE"]},
        "chapter_revision_ref": {
          "oneOf": [{"$ref": "#/$defs/chapter_revision_ref"}, {"type": "null"}]
        },
        "handover_receipt_ref": {
          "oneOf": [{"$ref": "#/$defs/handover_receipt_ref"}, {"type": "null"}]
        },
        "written_progress_delta": {"type": "integer", "minimum": 0, "maximum": 1},
        "provenance_seal_refs": {"$ref": "#/$defs/seal_refs"}
      }
    },
    "statement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["statement_id", "summary", "provenance_seal_refs"],
      "properties": {
        "statement_id": {"$ref": "#/$defs/non_empty_string"},
        "summary": {"$ref": "#/$defs/non_empty_string"},
        "provenance_seal_refs": {"$ref": "#/$defs/non_empty_seal_refs"}
      }
    },
    "path_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["object_ref", "revision", "object_sha256", "provenance_seal_refs"],
      "properties": {
        "object_ref": {"$ref": "#/$defs/non_empty_string"},
        "revision": {
          "oneOf": [
            {"type": "integer", "minimum": 1},
            {"$ref": "#/$defs/non_empty_string"}
          ]
        },
        "object_sha256": {"$ref": "#/$defs/sha256"},
        "provenance_seal_refs": {"$ref": "#/$defs/non_empty_seal_refs"}
      }
    },
    "planning": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "chapter_slot_snapshot_sha256",
        "source_plan_version",
        "source_plan_sha256",
        "adopted_path_refs",
        "original_target"
      ],
      "properties": {
        "chapter_slot_snapshot_sha256": {"$ref": "#/$defs/sha256"},
        "source_plan_version": {"type": "integer", "minimum": 1},
        "source_plan_sha256": {"$ref": "#/$defs/sha256"},
        "adopted_path_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/path_ref"}
        },
        "original_target": {"$ref": "#/$defs/statement"}
      }
    },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_disposition",
        "target_destination_ref",
        "actual_completion",
        "key_plot_skeleton",
        "important_state_changes"
      ],
      "properties": {
        "target_disposition": {
          "enum": ["COMPLETED", "PARTIAL", "DEFERRED", "REMAPPED", "ABANDONED", "PLANNING_ONLY"]
        },
        "target_destination_ref": {"$ref": "#/$defs/nullable_string"},
        "actual_completion": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/statement"}
        },
        "key_plot_skeleton": {
          "type": "array",
          "items": {"$ref": "#/$defs/statement"}
        },
        "important_state_changes": {
          "type": "array",
          "items": {"$ref": "#/$defs/statement"}
        }
      }
    },
    "unresolved_owner_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expected_owner_contract", "missing_identity_semantics", "tracking_ref", "reason_code"],
      "properties": {
        "expected_owner_contract": {"$ref": "#/$defs/non_empty_string"},
        "missing_identity_semantics": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/non_empty_string"}
        },
        "tracking_ref": {"type": "string", "pattern": "^CCZ-[0-9]+$"},
        "reason_code": {"const": "OWNER_UNRESOLVED"}
      }
    },
    "ledger_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ledger_name",
        "result",
        "before_snapshot_sha256",
        "after_snapshot_sha256",
        "provenance_seal_refs",
        "unresolved_owner_ref"
      ],
      "properties": {
        "ledger_name": {
          "enum": [
            "chapter", "fact", "character", "location", "item", "faction",
            "system", "world_rule", "longline", "planning"
          ]
        },
        "result": {"enum": ["COMMITTED_CHANGE", "CONFIRMED_NO_CHANGE", "OWNER_UNRESOLVED"]},
        "before_snapshot_sha256": {
          "oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]
        },
        "after_snapshot_sha256": {
          "oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]
        },
        "provenance_seal_refs": {"$ref": "#/$defs/non_empty_seal_refs"},
        "unresolved_owner_ref": {
          "oneOf": [{"$ref": "#/$defs/unresolved_owner_ref"}, {"type": "null"}]
        }
      }
    },
    "unresolved_story_item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["item_id", "kind", "status", "summary", "provenance_seal_refs"],
      "properties": {
        "item_id": {"$ref": "#/$defs/non_empty_string"},
        "kind": {"enum": ["OBLIGATION", "HOOK", "QUESTION", "CONFLICT", "RISK"]},
        "status": {"enum": ["OPEN", "DEFERRED", "REMAPPED"]},
        "summary": {"$ref": "#/$defs/non_empty_string"},
        "provenance_seal_refs": {"$ref": "#/$defs/non_empty_seal_refs"}
      }
    },
    "next_chapter_handoff": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "scope_refs", "summary", "provenance_seal_refs"],
      "properties": {
        "mode": {"enum": ["CONTINUE_SCOPE", "SWITCH_SCOPE", "UNDECIDED"]},
        "scope_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/non_empty_string"}
        },
        "summary": {"$ref": "#/$defs/non_empty_string"},
        "provenance_seal_refs": {"$ref": "#/$defs/non_empty_seal_refs"}
      }
    },
    "seal_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/sha256"}
    },
    "non_empty_seal_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/sha256"}
    }
  }
}
