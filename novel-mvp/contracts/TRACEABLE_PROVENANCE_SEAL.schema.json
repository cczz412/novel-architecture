{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.novel-mvp/contracts/TRACEABLE_PROVENANCE_SEAL.schema.json",
  "title": "TRACEABLE_PROVENANCE_SEAL v1",
  "description": "Project-scoped, owner-native, direct provenance binding. Structural validation only.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "version",
    "truth_scope_ref",
    "claim_kind",
    "subject_ref",
    "formation_kind",
    "direct_basis_refs",
    "seal_sha256"
  ],
  "properties": {
    "contract": {"const": "TRACEABLE_PROVENANCE_SEAL"},
    "version": {"const": "v1"},
    "truth_scope_ref": {"$ref": "#/$defs/truth_scope_ref"},
    "claim_kind": {
      "enum": [
        "CANDIDATE_SOURCE_CLAIM",
        "OWNER_COMMIT_CLAIM",
        "OWNER_UNRESOLVED_CLAIM"
      ]
    },
    "subject_ref": {"$ref": "#/$defs/reference_wrapper"},
    "formation_kind": {
      "enum": [
        "C10_SPAN_TO_C11_REVISION",
        "WORK_DRAFT_TO_C11_REVISION",
        "LEGACY_SNAPSHOT_TO_C11_REVISION",
        "PROSE_EXTRACTION",
        "AUTHOR_DECLARATION",
        "SYSTEM_PROPOSAL",
        "CHAPTER_LOCAL_DELTA",
        "AUTHOR_ADOPTION",
        "DELEGATED_SYSTEM_ADOPTION",
        "CHAPTER_CLOSEOUT_ADMISSION",
        "SETTINGSTORE_COMMIT",
        "PLANSTORE_COMMIT"
      ]
    },
    "direct_basis_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/basis_ref"}
    },
    "seal_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "truth_scope_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["principal_author_id", "project_id"],
      "properties": {
        "principal_author_id": {"$ref": "#/$defs/non_empty_string"},
        "project_id": {"$ref": "#/$defs/non_empty_string"}
      }
    },
    "ledger_name": {
      "enum": [
        "chapter",
        "fact",
        "character",
        "location",
        "item",
        "faction",
        "system",
        "world_rule",
        "longline",
        "planning"
      ]
    },
    "source_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "source_sha256",
        "coordinate_basis",
        "start",
        "end",
        "slice_sha256"
      ],
      "properties": {
        "source_id": {"$ref": "#/$defs/non_empty_string"},
        "source_sha256": {"$ref": "#/$defs/sha256"},
        "coordinate_basis": {"const": "DECODED_UNICODE_CODEPOINT_V1"},
        "start": {"type": "integer", "minimum": 0},
        "end": {"type": "integer", "minimum": 1},
        "slice_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "c10_material_identity_revision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "record_contract_version",
        "material_unit_id",
        "identity_revision_no",
        "identity_revision_sha256",
        "identity_role",
        "identity_state",
        "source_ref"
      ],
      "properties": {
        "kind": {"const": "C10_MATERIAL_IDENTITY_REVISION"},
        "record_contract_version": {"enum": ["v1", "v2", "v3", "v4"]},
        "material_unit_id": {"$ref": "#/$defs/non_empty_string"},
        "identity_revision_no": {"type": "integer", "minimum": 1},
        "identity_revision_sha256": {"$ref": "#/$defs/sha256"},
        "identity_role": {
          "oneOf": [
            {"enum": ["INTRO", "CHAPTER", "SETTING", "TITLE", "TAGS"]},
            {"type": "null"}
          ]
        },
        "identity_state": {"enum": ["CONFIRMED", "CANDIDATE", "UNKNOWN"]},
        "source_ref": {"$ref": "#/$defs/source_ref"}
      }
    },
    "c10_source_span": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "source_id",
        "source_sha256",
        "coordinate_basis",
        "start",
        "end",
        "slice_sha256"
      ],
      "properties": {
        "kind": {"const": "C10_SOURCE_SPAN"},
        "source_id": {"$ref": "#/$defs/non_empty_string"},
        "source_sha256": {"$ref": "#/$defs/sha256"},
        "coordinate_basis": {"const": "DECODED_UNICODE_CODEPOINT_V1"},
        "start": {"type": "integer", "minimum": 0},
        "end": {"type": "integer", "minimum": 1},
        "slice_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "c11_chapter_revision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "chapter_id", "revision_no", "revision_text_sha256"],
      "properties": {
        "kind": {"const": "C11_CHAPTER_REVISION"},
        "chapter_id": {"type": "string", "pattern": "^c[0-9]{2,}$"},
        "revision_no": {"type": "integer", "minimum": 1},
        "revision_text_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "c11_verified_anchor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "chapter_id",
        "revision_no",
        "revision_text_sha256",
        "coordinate_basis",
        "start",
        "end",
        "slice_sha256"
      ],
      "properties": {
        "kind": {"const": "C11_VERIFIED_ANCHOR"},
        "chapter_id": {"type": "string", "pattern": "^c[0-9]{2,}$"},
        "revision_no": {"type": "integer", "minimum": 1},
        "revision_text_sha256": {"$ref": "#/$defs/sha256"},
        "coordinate_basis": {
          "const": "CHAPTER_REVISION_TEXT_UNICODE_CODEPOINT_0_BASED_HALF_OPEN"
        },
        "start": {"type": "integer", "minimum": 0},
        "end": {"type": "integer", "minimum": 1},
        "slice_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "chapter_revision_commit_receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "operation_id",
        "status",
        "chapter_id",
        "before_revision_no",
        "after_revision_no",
        "result",
        "text_sha256",
        "receipt_sha256"
      ],
      "properties": {
        "kind": {"const": "CHAPTER_REVISION_COMMIT_RECEIPT"},
        "operation_id": {"$ref": "#/$defs/non_empty_string"},
        "status": {
          "enum": [
            "COMMITTED",
            "NO_CHANGE",
            "REJECTED",
            "NEEDS_TARGET_CONFIRMATION",
            "NEEDS_MANUAL_RECOVERY"
          ]
        },
        "chapter_id": {"type": "string", "pattern": "^c[0-9]{2,}$"},
        "before_revision_no": {"type": "integer", "minimum": 1},
        "after_revision_no": {"type": "integer", "minimum": 1},
        "result": {"enum": ["REVISION_APPENDED", "UNCHANGED", "REJECTED"]},
        "text_sha256": {"$ref": "#/$defs/sha256"},
        "receipt_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "work_draft_revision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "work_ref",
        "work_rev",
        "slot_ref",
        "source_outline_ref",
        "content_sha256"
      ],
      "properties": {
        "kind": {"const": "WORK_DRAFT_REVISION"},
        "work_ref": {"$ref": "#/$defs/non_empty_string"},
        "work_rev": {"type": "integer", "minimum": 1},
        "slot_ref": {"$ref": "#/$defs/non_empty_string"},
        "source_outline_ref": {"$ref": "#/$defs/non_empty_string"},
        "content_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "owner_action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "action_contract",
        "action_contract_version",
        "action_id",
        "actor",
        "action_sha256"
      ],
      "properties": {
        "kind": {"const": "OWNER_ACTION"},
        "action_contract": {"$ref": "#/$defs/non_empty_string"},
        "action_contract_version": {"$ref": "#/$defs/non_empty_string"},
        "action_id": {"$ref": "#/$defs/non_empty_string"},
        "actor": {"enum": ["AUTHOR", "SYSTEM"]},
        "action_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "setting_ledger_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "ledger_name",
        "record_contract",
        "record_contract_version",
        "record_id",
        "rev",
        "record_sha256",
        "source_identity",
        "confirm_status",
        "evidence_refs"
      ],
      "properties": {
        "kind": {"const": "SETTING_LEDGER_RECORD"},
        "ledger_name": {
          "enum": ["character", "location", "item", "faction", "system", "world_rule"]
        },
        "record_contract": {"$ref": "#/$defs/non_empty_string"},
        "record_contract_version": {"$ref": "#/$defs/non_empty_string"},
        "record_id": {"$ref": "#/$defs/non_empty_string"},
        "rev": {"type": "integer", "minimum": 1},
        "record_sha256": {"$ref": "#/$defs/sha256"},
        "source_identity": {
          "enum": ["author_declared", "draft_inferred", "model_suggested", "pack_prefilled"]
        },
        "confirm_status": {"enum": ["candidate", "confirmed", "retired"]},
        "evidence_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "oneOf": [
              {"type": "string", "pattern": "^f[0-9]{3,}$"},
              {"const": "AUTHOR_ATTESTATION"}
            ]
          }
        }
      }
    },
    "plan_ledger_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "object_kind",
        "object_id",
        "rev",
        "record_sha256"
      ],
      "properties": {
        "kind": {"const": "PLAN_LEDGER_RECORD"},
        "object_kind": {"$ref": "#/$defs/non_empty_string"},
        "object_id": {"$ref": "#/$defs/non_empty_string"},
        "rev": {"type": "integer", "minimum": 1},
        "record_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "owner_commit_receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "owner_contract",
        "operation_id",
        "status",
        "subject_stable_id",
        "subject_revision",
        "subject_sha256",
        "receipt_sha256"
      ],
      "properties": {
        "kind": {"const": "OWNER_COMMIT_RECEIPT"},
        "owner_contract": {"$ref": "#/$defs/non_empty_string"},
        "operation_id": {"$ref": "#/$defs/non_empty_string"},
        "status": {"enum": ["COMMITTED", "NO_CHANGE"]},
        "subject_stable_id": {"$ref": "#/$defs/non_empty_string"},
        "subject_revision": {
          "oneOf": [
            {"type": "integer", "minimum": 1},
            {"type": "string", "minLength": 1}
          ]
        },
        "subject_sha256": {"$ref": "#/$defs/sha256"},
        "receipt_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "change_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "owner_contract",
        "operation_id",
        "actor",
        "action",
        "subject_stable_id",
        "subject_revision",
        "before_subject_sha256",
        "after_subject_sha256",
        "change_record_sha256"
      ],
      "properties": {
        "kind": {"const": "CHANGE_RECORD"},
        "owner_contract": {"$ref": "#/$defs/non_empty_string"},
        "operation_id": {"$ref": "#/$defs/non_empty_string"},
        "actor": {"$ref": "#/$defs/non_empty_string"},
        "action": {"$ref": "#/$defs/non_empty_string"},
        "subject_stable_id": {"$ref": "#/$defs/non_empty_string"},
        "subject_revision": {
          "oneOf": [
            {"type": "integer", "minimum": 1},
            {"type": "string", "minLength": 1}
          ]
        },
        "before_subject_sha256": {
          "oneOf": [
            {"$ref": "#/$defs/sha256"},
            {"type": "null"}
          ]
        },
        "after_subject_sha256": {"$ref": "#/$defs/sha256"},
        "change_record_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "unresolved_owner_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "object_role",
        "expected_owner_contract",
        "available_contract_ref",
        "missing_identity_semantics",
        "tracking_ref",
        "reason_code"
      ],
      "properties": {
        "kind": {"const": "OWNER_UNRESOLVED_REF"},
        "object_role": {
          "enum": [
            "FACT_CANDIDATE_VERSION",
            "FORMAL_FACT_VERSION",
            "LEGACY_C1_SNAPSHOT",
            "CANDIDATE_PRODUCER_RECEIPT",
            "INFERENCE_TRACE",
            "PERMISSION_SNAPSHOT",
            "CHAPTER_CLOSEOUT_RECEIPT",
            "FACT_PROMOTION_RECEIPT"
          ]
        },
        "expected_owner_contract": {"$ref": "#/$defs/non_empty_string"},
        "available_contract_ref": {"$ref": "#/$defs/non_empty_string"},
        "missing_identity_semantics": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/non_empty_string"}
        },
        "tracking_ref": {"type": "string", "pattern": "^CCZ-[0-9]+$"},
        "reason_code": {"const": "OWNER_UNRESOLVED"}
      }
    },
    "owner_ref": {
      "oneOf": [
        {"$ref": "#/$defs/c10_material_identity_revision"},
        {"$ref": "#/$defs/c10_source_span"},
        {"$ref": "#/$defs/c11_chapter_revision"},
        {"$ref": "#/$defs/c11_verified_anchor"},
        {"$ref": "#/$defs/chapter_revision_commit_receipt"},
        {"$ref": "#/$defs/work_draft_revision"},
        {"$ref": "#/$defs/owner_action"},
        {"$ref": "#/$defs/setting_ledger_record"},
        {"$ref": "#/$defs/plan_ledger_record"},
        {"$ref": "#/$defs/owner_commit_receipt"},
        {"$ref": "#/$defs/change_record"},
        {"$ref": "#/$defs/unresolved_owner_ref"}
      ]
    },
    "reference_wrapper": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "truth_scope_ref",
        "source_kind",
        "logical_ledger_name",
        "stable_id",
        "revision",
        "role",
        "source_contract",
        "source_contract_version",
        "logical_content_sha256",
        "binding_mode",
        "retired_notice",
        "owner_ref"
      ],
      "properties": {
        "truth_scope_ref": {"$ref": "#/$defs/truth_scope_ref"},
        "source_kind": {
          "enum": [
            "material_identity",
            "source_span",
            "chapter_revision",
            "chapter_anchor",
            "work_draft",
            "owner_action",
            "ledger_entry",
            "owner_commit_receipt",
            "change_record",
            "unresolved_owner"
          ]
        },
        "logical_ledger_name": {
          "oneOf": [
            {"$ref": "#/$defs/ledger_name"},
            {"type": "null"}
          ]
        },
        "stable_id": {
          "oneOf": [
            {"$ref": "#/$defs/non_empty_string"},
            {"type": "null"}
          ]
        },
        "revision": {
          "oneOf": [
            {"type": "integer", "minimum": 1},
            {"type": "string", "minLength": 1},
            {"type": "null"}
          ]
        },
        "role": {"$ref": "#/$defs/non_empty_string"},
        "source_contract": {"$ref": "#/$defs/non_empty_string"},
        "source_contract_version": {"$ref": "#/$defs/non_empty_string"},
        "logical_content_sha256": {
          "oneOf": [
            {"$ref": "#/$defs/sha256"},
            {"type": "null"}
          ]
        },
        "binding_mode": {"enum": ["recorded_pin", "resolved_at_read"]},
        "retired_notice": {"type": "boolean"},
        "owner_ref": {"$ref": "#/$defs/owner_ref"}
      }
    },
    "basis_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["basis_role", "ref"],
      "properties": {
        "basis_role": {
          "enum": [
            "CONTENT_BASIS",
            "AUTHORITY_EVIDENCE",
            "OWNER_COMMIT_RECEIPT",
            "CHANGE_RECORD",
            "PRIOR_SUBJECT_VERSION",
            "SOURCE_EVIDENCE_ANCHOR",
            "INFERENCE_TRACE",
            "PRODUCER_RECEIPT"
          ]
        },
        "ref": {"$ref": "#/$defs/reference_wrapper"}
      }
    }
  }
}
