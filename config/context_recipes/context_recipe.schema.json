{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "context-recipe-v1",
  "title": "上下文配方 v1",
  "description": "通用严格上下文配方。输入槽和消息数量可扩展，但来源、大小和能力边界必须显式且有限。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "recipe_id",
    "revision",
    "status",
    "profile_id",
    "api_contract_bundle",
    "prompt_manifest",
    "task_output_schema",
    "input_slots",
    "message_plan",
    "assembly_policy",
    "capability_limits"
  ],
  "properties": {
    "schema_version": {
      "const": "context-recipe-v1"
    },
    "recipe_id": {
      "$ref": "#/$defs/safe_id"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "const": "candidate_only_not_wired_to_default_chain"
    },
    "profile_id": {
      "$ref": "#/$defs/safe_id"
    },
    "api_contract_bundle": {
      "$ref": "#/$defs/file_reference"
    },
    "prompt_manifest": {
      "$ref": "#/$defs/file_reference"
    },
    "task_output_schema": {
      "$ref": "#/$defs/file_reference"
    },
    "input_slots": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 32,
      "propertyNames": {
        "$ref": "#/$defs/safe_id"
      },
      "additionalProperties": {
        "$ref": "#/$defs/input_slot"
      }
    },
    "message_plan": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "$ref": "#/$defs/message_item"
      }
    },
    "assembly_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "allow_extra_messages",
        "allow_content_prefix",
        "allow_content_suffix",
        "allow_template_substitution"
      ],
      "properties": {
        "mode": {
          "type": "string",
          "pattern": "^strict_[a-z0-9._-]+$",
          "maxLength": 120
        },
        "allow_extra_messages": {
          "const": false
        },
        "allow_content_prefix": {
          "const": false
        },
        "allow_content_suffix": {
          "const": false
        },
        "allow_template_substitution": {
          "const": false
        }
      },
      "patternProperties": {
        "^[a-z][a-z0-9._-]*_content$": {
          "$ref": "#/$defs/nonempty_string"
        }
      }
    },
    "capability_limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "offline_resolve_only",
        "network",
        "credential_read",
        "request_send",
        "model_api",
        "notion_write"
      ],
      "properties": {
        "offline_resolve_only": {
          "const": true
        },
        "network": {
          "const": false
        },
        "credential_read": {
          "const": false
        },
        "request_send": {
          "const": false
        },
        "model_api": {
          "const": false
        },
        "notion_write": {
          "const": false
        }
      }
    }
  },
  "$defs": {
    "safe_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,119}$"
    },
    "nonempty_string": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "repo_relative_path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "pattern": "^(?!/)(?!.*//)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*\\\\)[A-Za-z0-9._/-]+$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "file_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/repo_relative_path"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "input_slot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required",
        "content_type",
        "serialization",
        "max_bytes"
      ],
      "properties": {
        "required": {
          "const": true
        },
        "content_type": {
          "$ref": "#/$defs/nonempty_string"
        },
        "serialization": {
          "$ref": "#/$defs/safe_id"
        },
        "max_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1048576
        }
      },
      "patternProperties": {
        "^(?!content_type$)[a-z0-9][a-z0-9._-]*_type$": {
          "$ref": "#/$defs/safe_id"
        },
        "^[a-z0-9][a-z0-9._-]*_keys$": {
          "$ref": "#/$defs/key_list"
        },
        "^[a-z0-9][a-z0-9._-]*_max_items$": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        }
      }
    },
    "key_list": {
      "type": "array",
      "maxItems": 128,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/safe_id"
      }
    },
    "message_item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "content_from"
      ],
      "properties": {
        "role": {
          "enum": [
            "system",
            "user",
            "assistant"
          ]
        },
        "content_from": {
          "type": "string",
          "pattern": "^(?:prompt_manifest\\.prompt_file|input_slots\\.[a-z0-9][a-z0-9._-]{0,119})$"
        }
      }
    }
  }
}
