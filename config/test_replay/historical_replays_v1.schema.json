{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "historical-test-replay-registry-v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "registry_id",
    "decision",
    "default_collection",
    "program_snapshot",
    "source_package",
    "source_roots",
    "source_units",
    "groups"
  ],
  "allOf": [
    {
      "if": {
        "required": ["source_package"],
        "properties": {
          "source_package": {
            "required": ["status"],
            "properties": {
              "status": {"const": "sealed"}
            }
          }
        }
      },
      "then": {
        "properties": {
          "source_package": {
            "properties": {
              "manifest_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "source_package": {
            "properties": {
              "manifest_sha256": {"type": "null"}
            }
          }
        }
      }
    }
  ],
  "properties": {
    "schema_version": {
      "const": "historical-test-replay-registry-v1"
    },
    "registry_id": {
      "type": "string",
      "minLength": 1
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authority", "choice", "source_text", "source_text_sha256"],
      "properties": {
        "authority": {"const": "CZ"},
        "choice": {"const": "S-05-B"},
        "source_text": {"const": "S-05-B"},
        "source_text_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "default_collection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "marker", "node_count"],
      "properties": {
        "mode": {"const": "deselect_exact"},
        "marker": {"const": "historical_replay"},
        "node_count": {"const": 40}
      }
    },
    "program_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "dirty_worktree_included",
        "internal_symlink_mode",
        "allowed_omitted_symlinks"
      ],
      "properties": {
        "source": {"const": "git_archive_resolved_commit"},
        "dirty_worktree_included": {"const": false},
        "internal_symlink_mode": {
          "const": "copy_tracked_target_bytes_as_regular_file"
        },
        "allowed_omitted_symlinks": {
          "type": "array",
          "prefixItems": [{"const": "corpus-downloads"}],
          "items": false
        }
      }
    },
    "source_package": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "package_id",
        "status",
        "external_root_id",
        "relative_path",
        "manifest_sha256"
      ],
      "properties": {
        "package_id": {"type": "string", "minLength": 1},
        "status": {"enum": ["unsealed", "sealed"]},
        "external_root_id": {
          "const": "repository_sibling_external_archive_v1"
        },
        "relative_path": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$"
        },
        "manifest_sha256": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "source_roots": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["root_id", "kind"],
        "properties": {
          "root_id": {"type": "string", "minLength": 1},
          "kind": {
            "enum": [
              "fixed_sibling_archive_batch",
              "repository_local_ignored"
            ]
          },
          "relative_path": {"type": "string"},
          "manifest_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "source_units": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "unit_id",
          "root_id",
          "repo_relative_path",
          "kind"
        ],
        "properties": {
          "unit_id": {"type": "string", "minLength": 1},
          "root_id": {"type": "string", "minLength": 1},
          "repo_relative_path": {"type": "string", "minLength": 1},
          "kind": {"enum": ["directory", "file"]}
        }
      }
    },
    "groups": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "group_id",
          "reason",
          "nodeids",
          "source_unit_ids"
        ],
        "properties": {
          "group_id": {"type": "string", "minLength": 1},
          "reason": {"type": "string", "minLength": 1},
          "nodeids": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          },
          "source_unit_ids": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    }
  }
}
