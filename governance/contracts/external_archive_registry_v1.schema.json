{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/governance/contracts/external_archive_registry_v1.schema.json",
  "title": "Repository artifact storage registry v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "registry_id",
    "updated_at",
    "authority",
    "capability_limits",
    "size_policy",
    "storage_roots",
    "objects",
    "known_conflicts"
  ],
  "properties": {
    "schema_version": {
      "const": "artifact-storage-v1"
    },
    "registry_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]+$"
    },
    "updated_at": {
      "type": "string",
      "format": "date"
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "may_define_current_task",
        "may_authorize_migration",
        "may_authorize_deletion",
        "may_claim_independent_backup",
        "conflict_rule"
      ],
      "properties": {
        "scope": {
          "const": "artifact_identity_location_and_inventory_only"
        },
        "may_define_current_task": {
          "const": false
        },
        "may_authorize_migration": {
          "const": false
        },
        "may_authorize_deletion": {
          "const": false
        },
        "may_claim_independent_backup": {
          "const": false
        },
        "conflict_rule": {
          "const": "registered_open_conflict_stays_visible_until_separate_adjudication"
        }
      }
    },
    "capability_limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inventory_only",
        "registered_anchor_read",
        "registered_manifest_read",
        "external_payload_traversal",
        "external_object_content_read",
        "write",
        "move",
        "delete",
        "restore",
        "recoverability_claim",
        "network",
        "credential_read",
        "model_call",
        "notion_write"
      ],
      "properties": {
        "inventory_only": {
          "const": true
        },
        "registered_anchor_read": {
          "const": true
        },
        "registered_manifest_read": {
          "const": true
        },
        "external_payload_traversal": {
          "const": false
        },
        "external_object_content_read": {
          "const": false
        },
        "write": {
          "const": false
        },
        "move": {
          "const": false
        },
        "delete": {
          "const": false
        },
        "restore": {
          "const": false
        },
        "recoverability_claim": {
          "const": false
        },
        "network": {
          "const": false
        },
        "credential_read": {
          "const": false
        },
        "model_call": {
          "const": false
        },
        "notion_write": {
          "const": false
        }
      }
    },
    "size_policy": {
      "$ref": "#/$defs/sizePolicy"
    },
    "storage_roots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/storageRoot"
      }
    },
    "objects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/artifactObject"
      }
    },
    "known_conflicts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/knownConflict"
      }
    }
  },
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "safeRelativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*//)(?!.*\\\\).+$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "activationReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/safeRelativePath"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "sizePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metric",
        "mode",
        "pre_s06a_baseline_bytes",
        "active_limit_bytes",
        "target_bytes",
        "hard_limit_bytes",
        "activation_receipt",
        "hard_limit_activation",
        "boundary"
      ],
      "properties": {
        "metric": {
          "const": "git_index_per_tracked_path_blob_bytes"
        },
        "mode": {
          "enum": [
            "s06a_bootstrap_no_growth",
            "hard_limit"
          ]
        },
        "pre_s06a_baseline_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "active_limit_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "target_bytes": {
          "const": 10000000
        },
        "hard_limit_bytes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "activation_receipt": {
          "oneOf": [
            {
              "$ref": "#/$defs/activationReceipt"
            },
            {
              "type": "null"
            }
          ]
        },
        "hard_limit_activation": {
          "const": "blocked_in_s06a_until_separate_payload_validator"
        },
        "boundary": {
          "$ref": "#/$defs/nonEmptyString"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "hard_limit"
              }
            }
          },
          "then": {
            "properties": {
              "hard_limit_bytes": {
                "const": 10000000
              },
              "activation_receipt": {
                "$ref": "#/$defs/activationReceipt"
              },
              "active_limit_bytes": {
                "const": 10000000
              }
            }
          },
          "else": {
            "properties": {
              "hard_limit_bytes": {
                "type": "null"
              },
              "activation_receipt": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "rootLocator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "suffix"
      ],
      "properties": {
        "kind": {
          "enum": [
            "repository",
            "repository_sibling_suffix"
          ]
        },
        "suffix": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^_[^/\\\\]+$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "repository"
              }
            }
          },
          "then": {
            "properties": {
              "suffix": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "suffix": {
                "type": "string"
              }
            }
          }
        }
      ]
    },
    "storageRoot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "root_id",
        "locator",
        "role",
        "required",
        "failure_domain",
        "boundary"
      ],
      "properties": {
        "root_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]+$"
        },
        "locator": {
          "$ref": "#/$defs/rootLocator"
        },
        "role": {
          "enum": [
            "authoritative_repository",
            "external_archive",
            "isolated_experiment_workspace",
            "copied_test_workspace"
          ]
        },
        "required": {
          "const": true
        },
        "failure_domain": {
          "enum": [
            "primary_volume",
            "same_volume_as_repository",
            "not_assessed"
          ]
        },
        "boundary": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "anchor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "relative_path",
        "sha256"
      ],
      "properties": {
        "kind": {
          "enum": [
            "root_identity_document",
            "nested_contract_manifest",
            "delivery_receipt"
          ]
        },
        "relative_path": {
          "$ref": "#/$defs/safeRelativePath"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "root_identity_document"
              }
            }
          },
          "then": {
            "properties": {
              "relative_path": {
                "enum": [
                  "README.md",
                  "INDEX.md",
                  "experiment.json",
                  "00_外部评审采纳与边界.md"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "nested_contract_manifest"
              }
            }
          },
          "then": {
            "properties": {
              "relative_path": {
                "pattern": "^(?!payload/|inputs/|requests/|responses/|candidate/|scorecard/)[^/]+/manifest\\.json$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "delivery_receipt"
              }
            }
          },
          "then": {
            "properties": {
              "relative_path": {
                "pattern": "^08_交付/[A-Z0-9_]+_RECEIPT\\.json$"
              }
            }
          }
        }
      ]
    },
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relative_path",
        "sha256",
        "expected_entry_count",
        "entries_field",
        "entry_path_field",
        "entry_sha256_field"
      ],
      "properties": {
        "relative_path": {
          "const": "MANIFEST.json"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "expected_entry_count": {
          "type": "integer",
          "minimum": 1
        },
        "entries_field": {
          "enum": [
            "entries",
            "files"
          ]
        },
        "entry_path_field": {
          "type": "string",
          "minLength": 1
        },
        "entry_sha256_field": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      }
    },
    "artifactObject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "root_id",
        "relative_path",
        "category",
        "status",
        "record_kind",
        "lifecycle",
        "consumer_closure",
        "verification_level",
        "recoverability",
        "externalization",
        "purpose_summary",
        "identity_anchors",
        "manifest",
        "keep_in_repository",
        "externalize_later",
        "consumers",
        "boundary"
      ],
      "properties": {
        "artifact_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]+$"
        },
        "root_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]+$"
        },
        "relative_path": {
          "$ref": "#/$defs/safeRelativePath"
        },
        "category": {
          "enum": [
            "legacy_external_container",
            "external_archive_batch",
            "historical_test_replay_package",
            "isolated_experiment",
            "repository_experiment"
          ]
        },
        "status": {
          "enum": [
            "candidate",
            "frozen",
            "negative",
            "unknown",
            "working",
            "superseded",
            "sealed"
          ]
        },
        "record_kind": {
          "enum": [
            "single_experiment",
            "family_container",
            "archive_batch",
            "workspace_container",
            "replay_package"
          ]
        },
        "lifecycle": {
          "enum": [
            "active_working_copy",
            "candidate",
            "historical",
            "frozen",
            "superseded",
            "unknown"
          ]
        },
        "consumer_closure": {
          "enum": [
            "open",
            "verified",
            "not_applicable"
          ]
        },
        "verification_level": {
          "enum": [
            "directory_presence_only",
            "identity_anchor",
            "manifest_only",
            "cryptographically_sealed"
          ]
        },
        "recoverability": {
          "enum": [
            "not_proven",
            "package_integrity_proven_same_failure_domain",
            "not_applicable"
          ]
        },
        "externalization": {
          "enum": [
            "already_external",
            "stay_isolation_workspace",
            "per_object_candidate",
            "blocked_until_identity",
            "prohibited"
          ]
        },
        "purpose_summary": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "identity_anchors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/anchor"
          }
        },
        "manifest": {
          "oneOf": [
            {
              "$ref": "#/$defs/manifest"
            },
            {
              "type": "null"
            }
          ]
        },
        "keep_in_repository": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        },
        "externalize_later": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        },
        "consumers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        },
        "boundary": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "knownConflict": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "conflict_id",
        "severity",
        "status",
        "summary",
        "artifact_ids",
        "boundary"
      ],
      "properties": {
        "conflict_id": {
          "type": "string",
          "pattern": "^[A-Z0-9][A-Z0-9_-]+$"
        },
        "severity": {
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "status": {
          "const": "open"
        },
        "summary": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "artifact_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]+$"
          }
        },
        "boundary": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    }
  }
}
