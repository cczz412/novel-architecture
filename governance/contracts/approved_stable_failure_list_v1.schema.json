{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/governance/contracts/approved_stable_failure_list_v1.schema.json",
  "title": "Approved stable pytest failure list v1",
  "description": "CZ 批准的干净克隆全仓 pytest 失败 ID 冻结清单。合并含本文件的 PR 即批准。运行现场无权增删。payload_sha256 是去掉该字段后的规范 JSON SHA-256。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "approval",
    "predicate",
    "main_sha",
    "failure_count",
    "payload_sha256",
    "command",
    "failures"
  ],
  "properties": {
    "contract_version": {
      "const": "approved-stable-failure-list-v1"
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "issue",
        "note"
      ],
      "properties": {
        "status": {
          "const": "EFFECTIVE_ON_MERGE"
        },
        "issue": {
          "const": "63"
        },
        "note": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "predicate": {
      "const": "PASS_WITH_STABLE_MAIN_EXISTING_NON_NOVEL_DEBT"
    },
    "main_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "failure_count": {
      "type": "integer",
      "minimum": 1
    },
    "payload_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "command": {
      "type": "string",
      "minLength": 1
    },
    "environment": {
      "type": "string"
    },
    "failures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "domain",
          "attribution"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "domain": {
            "type": "string",
            "minLength": 1
          },
          "attribution": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
