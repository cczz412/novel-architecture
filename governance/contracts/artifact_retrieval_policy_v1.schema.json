{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/governance/contracts/artifact_retrieval_policy_v1.schema.json",
  "title": "Artifact retrieval policy v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "policy_id",
    "registry_id",
    "validation_policy_id",
    "authority",
    "capability_limits",
    "allowed_root_ids",
    "cards",
    "protected_non_targets",
    "boundary"
  ],
  "properties": {
    "contract_version": {
      "const": "artifact-retrieval-policy-v1"
    },
    "policy_id": {
      "$ref": "#/$defs/id"
    },
    "registry_id": {
      "$ref": "#/$defs/id"
    },
    "validation_policy_id": {
      "$ref": "#/$defs/id"
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "may_discover_targets",
        "may_read_payload",
        "may_copy",
        "may_move",
        "may_delete",
        "may_restore",
        "may_issue_migration_receipt",
        "may_activate_hard_limit"
      ],
      "properties": {
        "scope": {
          "const": "registered_manifest_to_copy_plan_only"
        },
        "may_discover_targets": {
          "const": false
        },
        "may_read_payload": {
          "const": false
        },
        "may_copy": {
          "const": false
        },
        "may_move": {
          "const": false
        },
        "may_delete": {
          "const": false
        },
        "may_restore": {
          "const": false
        },
        "may_issue_migration_receipt": {
          "const": false
        },
        "may_activate_hard_limit": {
          "const": false
        }
      }
    },
    "capability_limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "one_card_per_command",
        "registered_manifest_read",
        "deterministic_plan_output",
        "write",
        "network",
        "credential_read",
        "model_call",
        "notion_write"
      ],
      "properties": {
        "one_card_per_command": {
          "const": true
        },
        "registered_manifest_read": {
          "const": true
        },
        "deterministic_plan_output": {
          "const": true
        },
        "write": {
          "const": false
        },
        "network": {
          "const": false
        },
        "credential_read": {
          "const": false
        },
        "model_call": {
          "const": false
        },
        "notion_write": {
          "const": false
        }
      }
    },
    "allowed_root_ids": {
      "type": "array",
      "const": [
        "repository_sibling_external_archive_v1"
      ]
    },
    "cards": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/card"
      }
    },
    "protected_non_targets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/protected"
      }
    },
    "boundary": {
      "$ref": "#/$defs/nonEmptyString"
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]+$"
    },
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "repoPath": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*//)[^\\u0000]+$"
    },
    "cardRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^(?:config/test_replay/result_cards/[a-z0-9][a-z0-9._-]+|experiments/[A-Za-z0-9][A-Za-z0-9._-]+)/result_card\\.json$"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "card": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "card_id",
        "result_card_ref",
        "allowed_selection_ids"
      ],
      "properties": {
        "card_id": {
          "$ref": "#/$defs/id"
        },
        "result_card_ref": {
          "$ref": "#/$defs/cardRef"
        },
        "allowed_selection_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        }
      }
    },
    "protected": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject_id",
        "reason",
        "discovery_prohibited"
      ],
      "properties": {
        "subject_id": {
          "$ref": "#/$defs/id"
        },
        "reason": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "discovery_prohibited": {
          "const": true
        }
      }
    }
  }
}
