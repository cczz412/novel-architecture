{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/governance/contracts/artifact_retrieval_profile_v1.schema.json",
  "title": "Artifact retrieval profile v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "profile_id",
    "artifact_id",
    "operation",
    "source_scope",
    "destination",
    "selections",
    "safety",
    "boundary"
  ],
  "properties": {
    "contract_version": {
      "const": "artifact-retrieval-profile-v1"
    },
    "profile_id": {
      "$ref": "#/$defs/id"
    },
    "artifact_id": {
      "$ref": "#/$defs/id"
    },
    "operation": {
      "const": "copy"
    },
    "source_scope": {
      "const": "registered_external_payload_manifest"
    },
    "destination": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "root_id",
        "relative_root",
        "fresh_workspace_required",
        "no_overwrite"
      ],
      "properties": {
        "root_id": {
          "const": "repository_sibling_test_workspace_v1"
        },
        "relative_root": {
          "const": "payload"
        },
        "fresh_workspace_required": {
          "const": true
        },
        "no_overwrite": {
          "const": true
        }
      }
    },
    "selections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/selection"
      }
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reject_symlink",
        "reject_hardlink",
        "reject_special_file",
        "verify_source_before_copy",
        "verify_target_after_copy",
        "no_source_write",
        "no_runtime_source_reference"
      ],
      "properties": {
        "reject_symlink": {
          "const": true
        },
        "reject_hardlink": {
          "const": true
        },
        "reject_special_file": {
          "const": true
        },
        "verify_source_before_copy": {
          "const": true
        },
        "verify_target_after_copy": {
          "const": true
        },
        "no_source_write": {
          "const": true
        },
        "no_runtime_source_reference": {
          "const": true
        }
      }
    },
    "boundary": {
      "$ref": "#/$defs/nonEmptyString"
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]+$"
    },
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "manifestPath": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*//)[^\\u0000]+$"
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "selection_id",
        "mode",
        "manifest_paths",
        "purpose"
      ],
      "properties": {
        "selection_id": {
          "$ref": "#/$defs/id"
        },
        "mode": {
          "enum": [
            "all_manifest_entries",
            "exact_manifest_paths"
          ]
        },
        "manifest_paths": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/manifestPath"
          }
        },
        "purpose": {
          "$ref": "#/$defs/nonEmptyString"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "all_manifest_entries"
              }
            }
          },
          "then": {
            "properties": {
              "manifest_paths": {
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "mode": {
                "const": "exact_manifest_paths"
              }
            }
          },
          "then": {
            "properties": {
              "manifest_paths": {
                "minItems": 1
              }
            }
          }
        }
      ]
    }
  }
}
