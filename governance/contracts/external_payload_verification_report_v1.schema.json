{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/governance/contracts/external_payload_verification_report_v1.schema.json",
  "title": "External payload verification report v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "status",
    "policy_id",
    "registry_id",
    "artifact_id",
    "root_id",
    "bindings",
    "verification",
    "claims",
    "checks"
  ],
  "properties": {
    "contract_version": {
      "const": "external-payload-verification-report-v1"
    },
    "status": {
      "const": "PASS",
      "description": "仅表示该外置对象 payload 字节核验通过。不是全仓 pytest 全绿，也不是 PASS_WITH_STABLE_MAIN_EXISTING_NON_NOVEL_DEBT（见 Issue #63 冻结批准清单）。未挂载外置卷不得使用本报告，改走 $defs.notRunReceipt（code=NOT_RUN_VOLUME_NOT_MOUNTED）。"
    },
    "policy_id": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "registry_id": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "artifact_id": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "root_id": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "registry_sha256",
        "policy_sha256",
        "manifest_sha256",
        "validator_sha256",
        "inventory_helper_sha256"
      ],
      "properties": {
        "registry_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "policy_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "manifest_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "validator_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "inventory_helper_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "storage_root_binding_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "storage_root_binding_schema_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "storage_root_binding_applied": {
          "type": "boolean"
        },
        "storage_root_device_fingerprint": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "file_count",
        "total_bytes",
        "entry_set_sha256",
        "exact_file_set",
        "content_sha256_verified",
        "snapshot_stable"
      ],
      "properties": {
        "file_count": {
          "type": "integer",
          "minimum": 1
        },
        "total_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "entry_set_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "exact_file_set": {
          "const": true
        },
        "content_sha256_verified": {
          "const": true
        },
        "snapshot_stable": {
          "const": true
        },
        "archive_representation": {
          "enum": [
            "directory_tree_v1",
            "tar_posix_tree_v1"
          ]
        },
        "symlink_count": {
          "type": "integer",
          "minimum": 0
        },
        "container_sha256_verified": {
          "type": "boolean"
        }
      }
    },
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "payload_bytes_match_manifest",
        "package_metadata_verified",
        "consumer_closure_verified",
        "pointer_resolution_verified",
        "recoverability_proven",
        "independent_backup_proven",
        "migration_performed",
        "hard_limit_activation_authorized",
        "deletion_authorized"
      ],
      "properties": {
        "payload_bytes_match_manifest": {
          "const": true
        },
        "package_metadata_verified": {
          "const": false
        },
        "consumer_closure_verified": {
          "const": false
        },
        "pointer_resolution_verified": {
          "const": false
        },
        "recoverability_proven": {
          "const": false
        },
        "independent_backup_proven": {
          "const": false
        },
        "migration_performed": {
          "const": false
        },
        "hard_limit_activation_authorized": {
          "const": false
        },
        "deletion_authorized": {
          "const": false
        }
      }
    },
    "checks": {
      "type": "array",
      "minItems": 8,
      "uniqueItems": true,
      "items": {
        "enum": [
          "policy_contract_valid",
          "artifact_allowlisted",
          "manifest_binding_valid",
          "payload_path_set_exact",
          "payload_sizes_exact",
          "payload_sha256_exact",
          "payload_snapshot_stable",
          "readonly_capability_respected"
        ]
      }
    }
  },
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "notRunReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "code",
        "artifact_id",
        "root_id",
        "expected_mount",
        "detail"
      ],
      "properties": {
        "status": {
          "const": "NOT_RUN"
        },
        "code": {
          "const": "NOT_RUN_VOLUME_NOT_MOUNTED"
        },
        "artifact_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "root_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "expected_mount": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "volume_uuid",
            "expected_volume_name",
            "relative_root"
          ],
          "properties": {
            "kind": {
              "type": [
                "string",
                "null"
              ]
            },
            "volume_uuid": {
              "type": [
                "string",
                "null"
              ]
            },
            "expected_volume_name": {
              "type": [
                "string",
                "null"
              ]
            },
            "relative_root": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "detail": {
          "type": "string"
        }
      }
    }
  }
}
