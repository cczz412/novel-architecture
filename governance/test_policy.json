      "tests": ["tests/test_api_transport_contract.py"],
      "full_chain": true
    },
    {
      "name": "公共工件库",
      "pattern": "tools/pipeline_common/*.py",
      "modules": ["M11"],
      "tests": ["tests/test_pipeline_artifacts.py", "tests/test_pipeline_inspector.py"],
      "full_chain": true
    },
    {
      "name": "语义检查分流器",
