    "M04": ["tests/test_api_transport_contract.py", "tests/test_novel_mvp_fact_review_transaction.py", "tests/test_novel_mvp_reconciliation_facts_admission.py"],
    "M05": ["tests/test_extract_module_contracts.py", "tests/test_novel_mvp_fact_review_transaction.py"],
    "M06": ["tests/test_z57_stable_semantic_identity.py"],
    "M07": ["tests/test_zbatch_cutover.py"],
    "M08": ["tests/test_zbatch.py", "tests/test_novel_mvp_planstore_handover.py", "tests/test_novel_mvp_reconciliation_facts_admission.py", "tests/test_novel_mvp_fact_review_transaction.py"],
    "M09": ["tests/test_z73_finalize_gold_v1_2.py"],
