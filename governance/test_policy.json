    "chapter_identity_changed",
    "anchor_identity_changed",
    "semantic_identity_changed",
    "unified_entry_changed",
    "transport_changed",
    "call_budget_changed",
    "security_cleaning_changed",
    "classification_semantics_changed",
    "gold_contract_changed",
    "score_denominator_changed",
    "file_routing_changed",
    "repository_layout_changed",
    "multi_module_unknown_impact"
