{
  "schema_version": "pipeline-test-policy-v1",
  "full_chain_command": "cd /Users/a1234/挣钱/小说架构 && /Users/a1234/挣钱/小说架构/.venv/bin/python -m pytest -q",
  "lint_command": "ruff check",
  "default_collection_root": "tests",
  "retired_collection_roots": ["TEMP", "runs", "reports", "outbox"],
  "archived_fixture_debt_registry": "tests/test_debt_registry.json",
