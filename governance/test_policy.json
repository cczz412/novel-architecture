{
  "schema_version": "pipeline-test-policy-v1",
  "full_chain_command": "cd \"$(git rev-parse --show-toplevel)\" && uv run --locked pytest -q",
  "lint_command": "uv run --locked ruff check",
  "default_collection_root": "tests",
  "retired_collection_roots": ["TEMP", "runs", "reports", "outbox"],
  "historical_replay_registry": "config/test_replay/historical_replays.json",
  "historical_replay_tool": "tools/historical_test_replay.py",
  "historical_replay_default_rule": "登记的40个精确节点默认deselected，不计入日常验收；只能从固定Git提交与已验SHA外置包复制出的同级工作副本一次回放全部40项。",
  "historical_replay_command": "uv run --locked python tools/historical_test_replay.py run --commit <完整40位提交号> --run-id <新运行号>",
  "legacy_debt_migration_pointer": "tests/test_debt_registry.json",
  "old_failure_disposition": "tests/old_failure_disposition.json",
  "approved_stable_failure_list": "governance/approved_stable_failure_list.json",
  "approved_stable_failure_list_schema": "governance/contracts/approved_stable_failure_list_v1.schema.json",
  "approved_stable_failure_list_checker": "tools/check_approved_failure_list.py",
  "documentation_commands": [
    "uv run --locked python tools/governance_index.py --check",
    "uv run --locked python tools/historical_test_replay.py validate"
  ],
  "unknown_path_full_chain": true,
  "full_chain_flags": [
    "module_contract_changed",
    "chapter_identity_changed",
    "anchor_identity_changed",
    "semantic_identity_changed",
    "unified_entry_changed",
    "transport_changed",
    "call_budget_changed",
    "security_cleaning_changed",
    "classification_semantics_changed",
    "gold_contract_changed",
    "score_denominator_changed",
    "file_routing_changed",
    "repository_layout_changed",
    "test_collection_changed",
    "historical_replay_changed",
    "multi_module_unknown_impact"
  ],
  "module_tests": {
    "M00": ["tests/test_zbatch.py"],
    "M01": ["tests/test_zbatch.py"],
    "M02": ["tests/test_zbatch_module_equivalence.py"],
